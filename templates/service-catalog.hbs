<div class="symbaroum-hud-service-catalog">
  <header class="symbaroum-hud-service-catalog-heading">
    <i class="fa-solid fa-bell-concierge" aria-hidden="true"></i>
    <span>
      <h1>{{localize "SYMBAROUMHUD.ServiceCatalog.Heading"}}</h1>
      <p>{{localize "SYMBAROUMHUD.ServiceCatalog.Introduction"}}</p>
    </span>
    <dl>
      <div><dt>{{localize "SYMBAROUMHUD.ServiceCatalog.Total"}}</dt><dd>{{count}}</dd></div>
      <div><dt>{{localize "SYMBAROUMHUD.ServiceCatalog.Official"}}</dt><dd>{{officialCount}}</dd></div>
      <div><dt>{{localize "SYMBAROUMHUD.ServiceCatalog.Custom"}}</dt><dd>{{customCount}}</dd></div>
    </dl>
  </header>

  <section class="symbaroum-hud-service-catalog-filters">
    <label class="symbaroum-hud-service-catalog-search">
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input type="search" data-service-catalog-search
        placeholder="{{localize 'SYMBAROUMHUD.ServiceCatalog.Search'}}"
        aria-label="{{localize 'SYMBAROUMHUD.ServiceCatalog.Search'}}">
    </label>
    <label>
      <span>{{localize "SYMBAROUMHUD.ServiceCatalog.Category"}}</span>
      <select data-service-catalog-category>
        <option value="all">{{localize "SYMBAROUMHUD.ServiceCatalog.AllCategories"}}</option>
        {{#each categories}}
          <option value="{{id}}">{{label}} ({{count}})</option>
        {{/each}}
      </select>
    </label>
    <label>
      <span>{{localize "SYMBAROUMHUD.ServiceCatalog.Catalog"}}</span>
      <select data-service-catalog-source>
        <option value="all">{{localize "SYMBAROUMHUD.ServiceCatalog.AllCatalogs"}}</option>
        <option value="official">{{localize "SYMBAROUMHUD.Services.OfficialCatalog"}}</option>
        <option value="custom">{{localize "SYMBAROUMHUD.Services.CustomCatalog"}}</option>
      </select>
    </label>
    <strong><span data-service-catalog-visible>{{count}}</span> {{localize "SYMBAROUMHUD.ServiceCatalog.Found"}}</strong>
  </section>

  <main class="symbaroum-hud-service-catalog-list">
    {{#each services}}
      <article data-service-catalog-entry data-category="{{category}}"
        data-catalog="{{#if official}}official{{else}}custom{{/if}}" data-search="{{searchText}}">
        <img src="{{img}}" alt="">
        <div class="symbaroum-hud-service-catalog-main">
          <header>
            <h2>{{name}}</h2>
            <span data-official="{{official}}">{{catalogLabel}}</span>
          </header>
          <p>{{description}}</p>
          <dl>
            <div><dt><i class="fa-solid fa-coins" aria-hidden="true"></i> {{localize "SYMBAROUMHUD.ServiceCatalog.Price"}}</dt><dd>{{cost}} / {{unitLabel}}</dd></div>
            <div><dt><i class="fa-solid {{categoryIcon}}" aria-hidden="true"></i> {{localize "SYMBAROUMHUD.ServiceCatalog.Category"}}</dt><dd>{{categoryLabel}}</dd></div>
            <div><dt><i class="fa-solid fa-clock" aria-hidden="true"></i> {{localize "SYMBAROUMHUD.ServiceCatalog.Fulfillment"}}</dt><dd>{{fulfillmentLabel}}</dd></div>
            <div><dt><i class="fa-solid fa-bookmark" aria-hidden="true"></i> {{localize "SYMBAROUMHUD.ServiceCatalog.Origin"}}</dt><dd>{{originLabel}}</dd></div>
          </dl>
          {{#if source}}<small><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{source}}</small>{{/if}}
        </div>
      </article>
    {{/each}}
    <div class="symbaroum-hud-service-catalog-empty" data-service-catalog-empty hidden>
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <strong>{{localize "SYMBAROUMHUD.ServiceCatalog.Empty"}}</strong>
      <span>{{localize "SYMBAROUMHUD.ServiceCatalog.EmptyHint"}}</span>
    </div>
  </main>
</div>
