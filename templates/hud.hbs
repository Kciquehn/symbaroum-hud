                        <i class="fa-solid fa-comment" aria-hidden="true"></i>
                      </button>
                      <button type="button" class="symbaroum-hud-simplified-pf2-card-btn"
                        data-action="open-power-sheet" data-item-id="{{simplifiedPowers.selectedCard.id}}"
                        data-tooltip="{{localize 'SYMBAROUMHUD.SimplifiedInventory.OpenSheet'}}"
                        aria-label="{{localize 'SYMBAROUMHUD.SimplifiedInventory.OpenSheet'}}">
                        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                      </button>
                      <button type="button" class="symbaroum-hud-simplified-pf2-card-btn is-close"
                        data-action="close-power-card"
                        data-tooltip="{{localize 'SYMBAROUMHUD.Actions.Close'}}"
                        aria-label="{{localize 'SYMBAROUMHUD.Actions.Close'}}">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                      </button>
                    </div>
                  </div>
                  <div class="symbaroum-hud-simplified-pf2-card-tags">
                    {{#if simplifiedPowers.selectedCard.badge}}
                      <span class="symbaroum-hud-simplified-pf2-tag">{{simplifiedPowers.selectedCard.badge}}</span>
                    {{/if}}
                    {{#if simplifiedPowers.selectedCard.actionLabel}}
                      <span class="symbaroum-hud-simplified-pf2-tag is-action">{{simplifiedPowers.selectedCard.actionLabel}}</span>
                    {{/if}}
                  </div>
                  {{#if simplifiedPowers.selectedCard.description}}
                    <div class="symbaroum-hud-simplified-pf2-text">
                      {{{simplifiedPowers.selectedCard.description}}}
                    </div>
                  {{/if}}
                </div>
              {{/if}}
            </section>
          {{/if}}
        </div>
        <div class="symbaroum-hud-simplified-hotbar-slot" data-symba-hotbar></div>
      </div>
    {{else}}
      <div class="symbaroum-hud-simplified-hotbar-slot" data-symba-hotbar></div>
    {{/if}}
  </div>
{{else}}
{{#if hasStatusSummary}}
