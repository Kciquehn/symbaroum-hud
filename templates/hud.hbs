{{#if isSimplified}}
  <div class="symbaroum-hud-simplified" data-symba-theme="simplified" data-simplified-mode="{{simplifiedMode}}">
    <div class="symbaroum-hud-simplified-sidebar">
      <button type="button" class="symbaroum-hud-simplified-sidebar-btn"
        data-action="cycle-hud-mode"
        data-hud-mode="{{simplifiedMode}}"
        data-tooltip="{{simplifiedModeTooltip}}"
        aria-label="{{simplifiedModeLabel}}">
        <i class="fa-solid {{simplifiedModeIcon}}" aria-hidden="true"></i>
      </button>
      <button type="button" class="symbaroum-hud-simplified-sidebar-btn{{#if isManualActor}} is-pinned{{/if}}"
        data-action="set-actor"
        data-tooltip="{{#if isManualActor}}{{localize 'SYMBAROUMHUD.Actions.SetActorPinned' name=actor.name}}{{else}}{{localize 'SYMBAROUMHUD.Actions.SetActorUnpinned'}}{{/if}}"
        aria-label="{{localize 'SYMBAROUMHUD.Actions.SetActor'}}"
        aria-pressed="{{#if isManualActor}}true{{else}}false{{/if}}">
        <i class="fa-solid {{#if isManualActor}}fa-turn-left{{else}}fa-user{{/if}}"></i>
      </button>
      <button type="button" class="symbaroum-hud-simplified-sidebar-btn"
        data-action="rest"
        data-tooltip="{{localize 'SYMBAROUMHUD.Actions.Rest'}}"
        aria-label="{{localize 'SYMBAROUMHUD.Actions.Rest'}}"
        {{#unless actions.rest}}disabled{{/unless}}>
        <i class="fa-solid fa-bed" aria-hidden="true"></i>
      </button>
    </div>
    {{#if actor}}
      <div class="symbaroum-hud-simplified-portrait-card">
        <div class="symbaroum-hud-simplified-status-summary">
          {{#if effects.length}}
            <div class="symbaroum-hud-simplified-effects-strip" role="list" aria-label="{{localize 'SYMBAROUMHUD.Sections.Effects'}}">
              {{#each effects}}
                <button type="button" class="symbaroum-hud-simplified-effect" role="listitem"
                  data-action="open-effect-menu"
                  data-effect-id="{{id}}"
                  data-tooltip="{{name}}"
                  aria-label="{{name}}">
                  <img src="{{img}}" alt="{{name}}">
                </button>
              {{/each}}
            </div>
          {{/if}}
          {{#if tactics}}
            <section class="symbaroum-hud-simplified-tactics" aria-label="{{localize 'BIO.TACTICS'}}"
              data-tactics-collapsed="{{tactics.collapsed}}">
              <header class="symbaroum-hud-simplified-tactics-header">
                <div class="symbaroum-hud-simplified-tactics-title">
                  <i class="fa-solid fa-chess-knight" aria-hidden="true"></i>
                  <span>{{localize "BIO.TACTICS"}}</span>
                </div>
                <button type="button" class="symbaroum-hud-simplified-tactics-toggle" data-action="toggle-tactics"
                  aria-expanded="{{#unless tactics.collapsed}}true{{else}}false{{/unless}}"
                  aria-label="{{#if tactics.collapsed}}{{localize 'SYMBAROUMHUD.Actions.ShowTactics'}}{{else}}{{localize 'SYMBAROUMHUD.Actions.HideTactics'}}{{/if}}"
                  data-tooltip="{{#if tactics.collapsed}}{{localize 'SYMBAROUMHUD.Actions.ShowTactics'}}{{else}}{{localize 'SYMBAROUMHUD.Actions.HideTactics'}}{{/if}}">
                  <i class="fa-solid {{#if tactics.collapsed}}fa-chevron-up{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i>
                </button>
              </header>
              <div class="symbaroum-hud-simplified-tactics-content" aria-hidden="{{tactics.collapsed}}">{{{tactics.html}}}</div>
            </section>
          {{/if}}
        </div>
        <button type="button" class="symbaroum-hud-simplified-portrait-btn" data-action="open-actor"
          aria-label="{{actor.name}}">
          <img src="{{actor.img}}" alt="{{actor.name}}">
        </button>
        <div class="symbaroum-hud-character-name">
          <button type="button" class="symbaroum-hud-character-name-label"
            data-action="{{#if canChooseOwnedActor}}toggle-actor-picker{{else}}open-actor{{/if}}"
            {{#if canChooseOwnedActor}}aria-haspopup="listbox" aria-expanded="{{actorPickerOpen}}"
              data-tooltip="{{localize 'SYMBAROUMHUD.Actions.ChooseActor'}}"{{/if}}>
            {{actor.name}}
          </button>
          {{#if canChooseOwnedActor}}
            <div class="symbaroum-hud-owned-actor-picker" data-owned-actor-picker role="listbox"
              aria-label="{{localize 'SYMBAROUMHUD.Actions.ChooseActor'}}" {{#unless actorPickerOpen}}hidden{{/unless}}>
              {{#each ownedActors}}
                <button type="button" role="option" data-action="select-owned-actor" data-actor-id="{{id}}"
                  data-active="{{active}}" aria-selected="{{active}}">
                  <img src="{{img}}" alt="">
                  <span>{{name}}</span>
                  {{#if active}}<i class="fa-solid fa-check" aria-hidden="true"></i>{{/if}}
                </button>
              {{/each}}
            </div>
          {{/if}}
        </div>
        {{#if actor.deathFailures}}
          <span class="symbaroum-hud-death-failures" data-tooltip="{{localize 'TOOLTIP.DEATH_SKULLS'}}">
            {{#each actor.deathFailures}}
              <i class="fa-solid fa-skull" aria-hidden="true"></i>
            {{/each}}
          </span>
        {{/if}}
        <span class="symbaroum-hud-character-resources">
          <button type="button" class="symbaroum-hud-character-resource" data-resource="vitality"
            data-action="modify-vitality"
            data-tooltip="{{localize 'SYMBAROUMHUD.Vitality.Manage'}}: {{actor.vitality.value}}/{{actor.vitality.max}}"
            aria-label="{{localize 'SYMBAROUMHUD.Vitality.Manage'}}: {{actor.vitality.value}}/{{actor.vitality.max}}"
            style="--symbaroum-hud-resource-percent: {{actor.vitality.percent}}%;"
            {{#unless actions.vitality}}disabled{{/unless}}>
            <span class="symbaroum-hud-character-resource-fill" aria-hidden="true"></span>
            <span class="symbaroum-hud-character-resource-value">
              <i class="fa-solid fa-heart" aria-hidden="true"></i>
              <strong>{{actor.vitality.value}}</strong>/{{actor.vitality.max}}
            </span>
          </button>
          <button type="button" class="symbaroum-hud-character-resource" data-resource="corruption"
            data-action="modify-corruption"
            data-tooltip="{{localize 'SYMBAROUMHUD.Corruption.Manage'}}: {{actor.corruption.temporary}}+{{actor.corruption.permanent}}/{{actor.corruption.max}}"
            aria-label="{{localize 'SYMBAROUMHUD.Corruption.Manage'}}: {{actor.corruption.temporary}}+{{actor.corruption.permanent}}/{{actor.corruption.max}}"
            style="--symbaroum-hud-resource-percent: {{actor.corruption.percent}}%;"
            {{#unless actions.corruption}}disabled{{/unless}}>
            <span class="symbaroum-hud-character-resource-fill" aria-hidden="true"></span>
            <span class="symbaroum-hud-character-resource-value">
              <i class="fa-solid fa-droplet" aria-hidden="true"></i>
              <strong>{{actor.corruption.temporary}}+{{actor.corruption.permanent}}</strong>/{{actor.corruption.max}}
            </span>
          </button>
        </span>
      </div>
      <div class="symbaroum-hud-simplified-main-column">
        <div class="symbaroum-hud-simplified-upper-row">
          <section class="symbaroum-hud-attributes" aria-label="{{localize 'SYMBAROUMHUD.Sections.Attributes'}}">
            {{#each attributes}}
              <button type="button" class="symbaroum-hud-attribute"
                data-action="roll-attribute" data-attribute="{{id}}"
                data-tooltip="{{label}}: {{value}}" aria-label="{{label}}: {{value}}"
                {{#unless ../actions.attributes}}disabled{{/unless}}>
                <i class="fa-solid {{icon}}" aria-hidden="true"></i>
                <span class="symbaroum-hud-attribute-name">{{label}}</span>
                <strong>{{value}}</strong>
              </button>
            {{/each}}
          </section>
          <div class="symbaroum-hud-simplified-deck">
            <div class="symbaroum-hud-simplified-info-bar">
              <button type="button"
                class="symbaroum-hud-simplified-info-chip is-defense"
                data-action="roll-defense"
                data-tooltip="{{localize 'SYMBAROUMHUD.SimplifiedInfo.Defense'}}: {{info.defense}} - {{localize 'SYMBAROUMHUD.SimplifiedInfo.DefenseRollTooltip'}}"
                aria-label="{{localize 'SYMBAROUMHUD.SimplifiedInfo.Defense'}}: {{info.defense}}">
                <div class="symbaroum-hud-simplified-chip-header">
                  <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                  <span class="symbaroum-hud-simplified-chip-label">{{localize "SYMBAROUMHUD.SimplifiedInfo.Defense"}}</span>
                </div>
                <strong class="symbaroum-hud-simplified-chip-val">{{info.defense}}</strong>
              </button>

              <button type="button"
                class="symbaroum-hud-simplified-info-chip is-armor"
                data-action="roll-armor-protection"
                data-tooltip="{{info.armorName}} ({{info.armor}}) - {{localize 'SYMBAROUMHUD.SimplifiedInfo.ArmorRollTooltip'}}"
                aria-label="{{localize 'SYMBAROUMHUD.SimplifiedInfo.ArmorProtection'}}: {{info.armor}}">
                <div class="symbaroum-hud-simplified-chip-header">
                  <i class="fa-solid fa-vest" aria-hidden="true"></i>
                  <span class="symbaroum-hud-simplified-chip-label">{{localize "SYMBAROUMHUD.SimplifiedInfo.ArmorProtection"}}</span>
                </div>
                <strong class="symbaroum-hud-simplified-chip-val">{{info.armor}}</strong>
              </button>

              <button type="button"
                class="symbaroum-hud-simplified-info-chip is-rations{{#unless info.rations}} is-empty{{/unless}}"
                data-action="consume-ration"
                data-tooltip="{{#if info.rations}}{{localize 'SYMBAROUMHUD.SimplifiedInfo.Waybread'}}: {{info.rations.usesRemaining}}/{{info.rations.usesPerUnit}} - {{localize 'SYMBAROUMHUD.Actions.ConsumeRation'}}{{else}}{{localize 'SYMBAROUMHUD.SimplifiedInfo.NoWaybread'}}{{/if}}"
                aria-label="{{localize 'SYMBAROUMHUD.SimplifiedInfo.Waybread'}}">
                <div class="symbaroum-hud-simplified-chip-header">
                  <i class="fa-solid fa-bread-slice" aria-hidden="true"></i>
                  <span class="symbaroum-hud-simplified-chip-label">{{localize "SYMBAROUMHUD.SimplifiedInfo.Rations"}}</span>
                </div>
                <strong class="symbaroum-hud-simplified-chip-val">{{#if info.rations}}{{info.rations.usesRemaining}}/{{info.rations.usesPerUnit}}{{else}}—{{/if}}</strong>
              </button>

              <button type="button"
                class="symbaroum-hud-simplified-info-chip is-quiver{{#unless info.quiver}} is-empty{{/unless}}"
                data-action="reload-quiver"
                data-quiver-id="{{info.quiver.id}}"
                data-tooltip="{{#if info.quiver}}{{info.quiver.name}}: {{info.quiver.loaded}}/{{info.quiver.capacity}} ({{localize 'SYMBAROUMHUD.SimplifiedInfo.ReloadQuiver'}}){{else}}{{localize 'SYMBAROUMHUD.SimplifiedInfo.NoQuiver'}}{{/if}}"
                aria-label="{{localize 'SYMBAROUMHUD.SimplifiedInfo.Quiver'}}">
                <div class="symbaroum-hud-simplified-chip-header">
                  <i class="fa-solid fa-bullseye" aria-hidden="true"></i>
                  <span class="symbaroum-hud-simplified-chip-label">{{localize "SYMBAROUMHUD.SimplifiedInfo.Quiver"}}</span>
                </div>
                <strong class="symbaroum-hud-simplified-chip-val">{{#if info.quiver}}{{info.quiver.loaded}}/{{info.quiver.capacity}}{{else}}—{{/if}}</strong>
              </button>
            </div>

            <div class="symbaroum-hud-simplified-buttons-row">
              <button type="button"
                class="symbaroum-hud-simplified-actions-btn{{#if simplifiedActionsOpen}} is-active{{/if}}"
                data-action="toggle-simplified-actions"
                data-tooltip="{{localize 'SYMBAROUMHUD.Actions.ToggleActions'}}"
                aria-label="{{localize 'SYMBAROUMHUD.Actions.ToggleActions'}}"
                aria-expanded="{{#if simplifiedActionsOpen}}true{{else}}false{{/if}}">
                <i class="fa-solid fa-person-running" aria-hidden="true"></i>
                <span>{{localize "SYMBAROUMHUD.Sections.ActionsTitle"}}</span>
              </button>
              <button type="button"
                class="symbaroum-hud-simplified-inventory-btn{{#if simplifiedInventoryOpen}} is-active{{/if}}"
                data-action="toggle-simplified-inventory"
                data-tooltip="{{localize 'SYMBAROUMHUD.Actions.ToggleInventory'}}"
                aria-label="{{localize 'SYMBAROUMHUD.Actions.ToggleInventory'}}"
                aria-expanded="{{#if simplifiedInventoryOpen}}true{{else}}false{{/if}}"
                data-storage-inventory-drop="true">
                <i class="fa-solid fa-backpack" aria-hidden="true"></i>
                <span>{{localize "SYMBAROUMHUD.Sections.Inventory"}}</span>
              </button>
              <button type="button"
                class="symbaroum-hud-simplified-powers-btn{{#if simplifiedPowersOpen}} is-active{{/if}}"
                data-action="toggle-simplified-powers"
                data-tooltip="{{localize 'SYMBAROUMHUD.Actions.TogglePowers'}}"
                aria-label="{{localize 'SYMBAROUMHUD.Actions.TogglePowers'}}"
                aria-expanded="{{#if simplifiedPowersOpen}}true{{else}}false{{/if}}">
                <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                <span>{{localize "SYMBAROUMHUD.Sections.PowersAndAbilities"}}</span>
              </button>
            </div>
          </div>

          {{#if simplifiedActionsOpen}}
            <section class="symbaroum-hud-simplified-actions-panel" aria-label="{{localize 'SYMBAROUMHUD.Sections.ActionsTitle'}}">
              <header class="symbaroum-hud-simplified-panel-header">
                <div class="symbaroum-hud-simplified-panel-title">
                  <i class="fa-solid fa-person-running" aria-hidden="true"></i>
                  <h3>{{localize "SYMBAROUMHUD.Sections.ActionsTitle"}}</h3>
                </div>
                <button type="button" class="symbaroum-hud-simplified-panel-close"
                  data-action="close-simplified-actions"
                  data-tooltip="{{localize 'SYMBAROUMHUD.Actions.CloseActions'}}"
                  aria-label="{{localize 'SYMBAROUMHUD.Actions.CloseActions'}}">
                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
              </header>

              <div class="symbaroum-hud-simplified-actions-content">
                {{#if simplifiedActions.attacks.length}}
                  <div class="symbaroum-hud-simplified-section-header">
                    <i class="fa-solid fa-swords" aria-hidden="true"></i>
                    <span>{{localize "SYMBAROUMHUD.Sections.Attacks"}}</span>
                  </div>
                  <div class="symbaroum-hud-simplified-action-list">
                    {{#each simplifiedActions.attacks}}
                      <div class="symbaroum-hud-simplified-item-row" data-item-id="{{id}}">
                        <button type="button" class="symbaroum-hud-simplified-item-img-btn"
                          data-action="roll-weapon" data-item-id="{{id}}"
                          data-item-uuid="{{uuid}}"
                          data-tooltip="{{localize 'SYMBAROUMHUD.Actions.RollWeapon'}}: {{name}}{{#if readinessKnown}} ({{readinessLabel}}){{/if}}"
                          aria-label="{{localize 'SYMBAROUMHUD.Actions.RollWeapon'}}: {{name}}"
                          {{#if draggable}}draggable="true" data-weapon-draggable="true"{{/if}}
                          {{#unless canUse}}disabled{{/unless}}>
                          <img src="{{img}}" alt="{{name}}">
                        </button>
                        <button type="button" class="symbaroum-hud-simplified-item-name-btn"
                          data-action="roll-weapon" data-item-id="{{id}}"
                          data-item-uuid="{{uuid}}"
                          data-tooltip="{{localize 'SYMBAROUMHUD.Actions.RollWeapon'}}: {{name}}{{#if readinessKnown}} ({{readinessLabel}}){{/if}}"
                          aria-label="{{localize 'SYMBAROUMHUD.Actions.RollWeapon'}}: {{name}}"
                          {{#unless canUse}}disabled{{/unless}}>
                          <span class="symbaroum-hud-simplified-item-name">{{name}}</span>
                        </button>
                        <div class="symbaroum-hud-simplified-item-controls">
                          {{#if readinessKnown}}
                            <button type="button" class="symbaroum-hud-simplified-readiness-btn"
                              data-drawn="{{drawn}}" data-item-id="{{id}}"
                              data-action="{{#if drawn}}sheathe-weapon{{else}}draw-weapon{{/if}}"
                              data-tooltip="{{#if drawn}}{{localize 'SYMBAROUMHUD.Attacks.SheatheAction'}}: {{name}}{{else}}{{localize 'SYMBAROUMHUD.Actions.DrawWeapon'}}: {{name}}{{/if}}"
                              aria-label="{{#if drawn}}{{localize 'SYMBAROUMHUD.Attacks.SheatheAction'}}: {{name}}{{else}}{{localize 'SYMBAROUMHUD.Actions.DrawWeapon'}}: {{name}}{{/if}}"
                              {{#unless canUse}}disabled{{/unless}}>
                              <i class="fa-solid {{#if drawn}}fa-hand-fist{{else}}fa-hand{{/if}}" aria-hidden="true"></i>
                            </button>
                          {{/if}}
                        </div>
                      </div>
                    {{/each}}
                  </div>
                {{/if}}

                {{#if simplifiedActions.abilities.length}}
                  <div class="symbaroum-hud-simplified-section-header">
                    <i class="fa-solid fa-bolt" aria-hidden="true"></i>
                    <span>{{localize "SYMBAROUMHUD.Sections.Abilities"}}</span>
                  </div>
                  <div class="symbaroum-hud-simplified-action-list">
                    {{#each simplifiedActions.abilities}}
                      <div class="symbaroum-hud-simplified-item-row" data-item-id="{{id}}">
                        <button type="button" class="symbaroum-hud-simplified-item-img-btn"
                          {{#if canUse}}data-action="use-ability"{{else}}data-action="open-ability"{{/if}}
                          data-item-id="{{id}}"
                          data-item-uuid="{{uuid}}"
                          data-tooltip="{{#if canUse}}{{localize 'SYMBAROUMHUD.Actions.UseAbility'}}{{else}}{{localize 'SYMBAROUMHUD.Actions.OpenAbility'}}{{/if}}: {{name}}"
                          aria-label="{{name}}">
                          <img src="{{img}}" alt="{{name}}">
                        </button>
                        <button type="button" class="symbaroum-hud-simplified-item-name-btn"
                          {{#if canUse}}data-action="use-ability"{{else}}data-action="open-ability"{{/if}}
                          data-item-id="{{id}}"
                          data-item-uuid="{{uuid}}"
                          data-tooltip="{{#if canUse}}{{localize 'SYMBAROUMHUD.Actions.UseAbility'}}{{else}}{{localize 'SYMBAROUMHUD.Actions.OpenAbility'}}{{/if}}: {{name}}"
                          aria-label="{{name}}">
                          <span class="symbaroum-hud-simplified-item-name">{{name}}</span>
                          {{#if actionLabel}}
                            <span class="symbaroum-hud-simplified-item-badge">{{actionLabel}}</span>
                          {{/if}}
                        </button>
                      </div>
                    {{/each}}
                  </div>
                {{/if}}

                {{#if simplifiedActions.mysticalPowers.length}}
                  <div class="symbaroum-hud-simplified-section-header">
                    <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                    <span>{{localize "SYMBAROUMHUD.Sections.MysticalPowers"}}</span>
                  </div>
                  <div class="symbaroum-hud-simplified-action-list">
                    {{#each simplifiedActions.mysticalPowers}}
                      <div class="symbaroum-hud-simplified-item-row" data-item-id="{{id}}">
                        <button type="button" class="symbaroum-hud-simplified-item-img-btn"
                          {{#if canUse}}data-action="use-mystical-power"{{else}}data-action="open-mystical-power"{{/if}}
                          data-item-id="{{id}}"
                          data-item-uuid="{{uuid}}"
                          data-tooltip="{{#if canUse}}{{localize 'SYMBAROUMHUD.Actions.UseMysticalPower'}}{{else}}{{localize 'SYMBAROUMHUD.Actions.OpenMysticalPower'}}{{/if}}: {{name}}"
                          aria-label="{{name}}">
                          <img src="{{img}}" alt="{{name}}">
                        </button>
                        <button type="button" class="symbaroum-hud-simplified-item-name-btn"
                          {{#if canUse}}data-action="use-mystical-power"{{else}}data-action="open-mystical-power"{{/if}}
                          data-item-id="{{id}}"
                          data-item-uuid="{{uuid}}"
                          data-tooltip="{{#if canUse}}{{localize 'SYMBAROUMHUD.Actions.UseMysticalPower'}}{{else}}{{localize 'SYMBAROUMHUD.Actions.OpenMysticalPower'}}{{/if}}: {{name}}"
                          aria-label="{{name}}">
                          <span class="symbaroum-hud-simplified-item-name">{{name}}</span>
                          {{#if actionLabel}}
                            <span class="symbaroum-hud-simplified-item-badge">{{actionLabel}}</span>
                          {{/if}}
                        </button>
                      </div>
                    {{/each}}
                  </div>
                {{/if}}

                {{#if simplifiedActions.traits.length}}
                  <div class="symbaroum-hud-simplified-section-header">
                    <i class="fa-solid fa-fingerprint" aria-hidden="true"></i>
                    <span>{{localize "SYMBAROUMHUD.Sections.Traits"}}</span>
                  </div>
                  <div class="symbaroum-hud-simplified-action-list">
                    {{#each simplifiedActions.traits}}
                      <div class="symbaroum-hud-simplified-item-row" data-item-id="{{id}}">
                        <button type="button" class="symbaroum-hud-simplified-item-img-btn"
                          data-action="use-trait" data-item-id="{{id}}"
                          data-item-uuid="{{uuid}}"
                          data-tooltip="{{localize 'SYMBAROUMHUD.Actions.UseTrait'}}: {{name}}"
                          aria-label="{{name}}">
                          <img src="{{img}}" alt="{{name}}">
                        </button>
                        <button type="button" class="symbaroum-hud-simplified-item-name-btn"
                          data-action="use-trait" data-item-id="{{id}}"
                          data-item-uuid="{{uuid}}"
                          data-tooltip="{{localize 'SYMBAROUMHUD.Actions.UseTrait'}}: {{name}}"
                          aria-label="{{name}}">
                          <span class="symbaroum-hud-simplified-item-name">{{name}}</span>
                        </button>
                      </div>
                    {{/each}}
                  </div>
                {{/if}}

                {{#if simplifiedActions.otherItems.length}}
                  <div class="symbaroum-hud-simplified-section-header">
                    <i class="fa-solid fa-flask" aria-hidden="true"></i>
                    <span>{{localize "SYMBAROUMHUD.Sections.Inventory"}}</span>
                  </div>
                  <div class="symbaroum-hud-simplified-action-list">
                    {{#each simplifiedActions.otherItems}}
                      <div class="symbaroum-hud-simplified-item-row" data-item-id="{{id}}">
                        <button type="button" class="symbaroum-hud-simplified-item-img-btn"
                          data-action="use-ability" data-item-id="{{id}}"
                          data-item-uuid="{{uuid}}"
                          data-tooltip="{{name}}"
                          aria-label="{{name}}">
                          <img src="{{img}}" alt="{{name}}">
                        </button>
                        <button type="button" class="symbaroum-hud-simplified-item-name-btn"
                          data-action="use-ability" data-item-id="{{id}}"
                          data-item-uuid="{{uuid}}"
                          data-tooltip="{{name}}"
                          aria-label="{{name}}">
                          <span class="symbaroum-hud-simplified-item-name">{{name}}</span>
                        </button>
                      </div>
                    {{/each}}
                  </div>
                {{/if}}

                {{#if simplifiedActions.maneuvers.length}}
                  <div class="symbaroum-hud-simplified-section-header">
                    <i class="fa-solid fa-chess-knight" aria-hidden="true"></i>
                    <span>{{localize "SYMBAROUMHUD.Sections.Maneuvers"}}</span>
                  </div>
                  <div class="symbaroum-hud-simplified-action-list">
                    {{#each simplifiedActions.maneuvers}}
                      <div class="symbaroum-hud-simplified-item-row" data-maneuver-id="{{id}}">
                        <button type="button" class="symbaroum-hud-simplified-item-img-btn"
                          data-action="execute-maneuver" data-maneuver-id="{{id}}"
                          data-tooltip="{{localize 'SYMBAROUMHUD.Maneuvers.Roll'}}: {{name}}"
                          aria-label="{{name}}"
                          {{#unless canUse}}disabled{{/unless}}>
                          <i class="fa-solid {{icon}}" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="symbaroum-hud-simplified-item-name-btn"
                          data-action="execute-maneuver" data-maneuver-id="{{id}}"
