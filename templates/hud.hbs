                </span>
              {{/each}}
              <button type="button" class="symbaroum-hud-ability-add"
                data-action="add-ability"
                data-tooltip="{{localize 'SYMBAROUMHUD.Abilities.Add'}}"
                aria-label="{{localize 'SYMBAROUMHUD.Abilities.Add'}}"
                {{#unless abilities.canUse}}disabled{{/unless}}>
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
              </button>
            </nav>

            <article class="symbaroum-hud-ability-detail"
              aria-label="{{localize 'SYMBAROUMHUD.Abilities.Detail'}}">
              {{#if abilities.selected}}
                <header class="symbaroum-hud-ability-detail-header">
                  <img src="{{abilities.selected.img}}" alt="">
                  <div class="symbaroum-hud-ability-detail-title">
                    <strong>{{abilities.selected.name}}</strong>
                    {{#if abilities.selected.reference}}
                      <span>{{localize "SYMBAROUMHUD.Abilities.Reference"}}: {{abilities.selected.reference}}</span>
                    {{/if}}
                  </div>
                  <div class="symbaroum-hud-ability-detail-actions">
                    {{#if abilities.selected.canUsePower}}
                      <button type="button" class="symbaroum-hud-ability-detail-action"
                        data-action="use-ability" data-item-id="{{abilities.selected.id}}"
                        data-tooltip="{{localize 'SYMBAROUMHUD.Actions.UseAbility'}}"
                        aria-label="{{localize 'SYMBAROUMHUD.Actions.UseAbility'}}"
                        {{#unless abilities.canUse}}disabled{{/unless}}>
                        <i class="fa-solid fa-dice-d20" aria-hidden="true"></i>
                        <span>{{localize "SYMBAROUMHUD.Actions.UseAbility"}}</span>
                      </button>
                    {{/if}}
                    <button type="button" class="symbaroum-hud-ability-detail-action"
                      data-action="open-ability" data-item-id="{{abilities.selected.id}}"
                      data-tooltip="{{localize 'SYMBAROUMHUD.Actions.OpenAbility'}}"
                      aria-label="{{localize 'SYMBAROUMHUD.Actions.OpenAbility'}}">
                      <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i>
                    </button>
                  </div>
                </header>

                {{#if abilities.selected.hasLevels}}
                  <nav class="symbaroum-hud-ability-tabs" role="tablist"
                    aria-label="{{localize 'SYMBAROUMHUD.Abilities.Tabs'}}">
                    {{#each abilities.selected.tabs}}
                      <button type="button" class="symbaroum-hud-ability-tab"
                        role="tab" data-action="select-ability-tab"
                        data-ability-tab="{{id}}" data-active="{{active}}"
                        data-learned="{{learned}}"
                        aria-selected="{{active}}">
                        {{#if learned}}
                          <i class="fa-solid fa-check" aria-hidden="true"></i>
                        {{/if}}
                        {{label}}
                      </button>
                    {{/each}}
                  </nav>
                {{/if}}

                <section class="symbaroum-hud-ability-tab-panel" role="tabpanel"
                  data-ability-section="{{abilities.selected.activeTab.id}}">
                  <header class="symbaroum-hud-ability-page-heading">
                    <div class="symbaroum-hud-ability-page-title">
                      <span aria-hidden="true"></span>
                      <h3>{{abilities.selected.activeTab.label}}</h3>
                      <span aria-hidden="true"></span>
                    </div>
                    {{#if abilities.selected.activeTab.level}}
                      <div class="symbaroum-hud-ability-level-controls">
                        {{#if abilities.selected.activeTab.action}}
                          <span class="symbaroum-hud-ability-tab-action">
                            <strong>{{abilities.selected.activeTab.action}}</strong>
                          </span>
                        {{/if}}
                        <button type="button" class="symbaroum-hud-ability-active-toggle"
                          data-action="toggle-ability-level"
                          data-item-id="{{abilities.selected.id}}"
                          data-ability-level="{{abilities.selected.activeTab.level}}"
                          data-active="{{abilities.selected.activeTab.learned}}"
                          aria-pressed="{{abilities.selected.activeTab.learned}}"
                          data-tooltip="{{localize 'SYMBAROUMHUD.Abilities.Active'}}"
                          aria-label="{{localize 'SYMBAROUMHUD.Abilities.Active'}}"
                          {{#unless abilities.canUse}}disabled{{/unless}}>
                          <span>{{localize "SYMBAROUMHUD.Abilities.Active"}}</span>
                          <i class="fa-solid {{#if abilities.selected.activeTab.learned}}fa-square-check{{else}}fa-square{{/if}}"
                            aria-hidden="true"></i>
                        </button>
                      </div>
                    {{/if}}
                  </header>
                  <div class="symbaroum-hud-ability-page-content">
                    {{#if abilities.selected.activeTab.description}}
                      <div class="symbaroum-hud-ability-description">
                        {{{abilities.selected.activeTab.description}}}
                      </div>
                    {{else}}
                      <span class="symbaroum-hud-ability-no-description">
                        {{localize "SYMBAROUMHUD.Abilities.NoDescription"}}
                      </span>
                    {{/if}}
                  </div>
                </section>
              {{else}}
                <span class="symbaroum-hud-ability-no-description">
                  {{localize "SYMBAROUMHUD.Abilities.Empty"}}
                </span>
              {{/if}}
            </article>
          </div>
        </section>
      {{/if}}

      {{#if traits.open}}
        <section id="symbaroum-hud-traits-panel" class="symbaroum-hud-abilities-panel symbaroum-hud-traits-panel"
          aria-label="{{localize 'SYMBAROUMHUD.Sections.Traits'}}">
          <header class="symbaroum-hud-storage-header symbaroum-hud-abilities-header">
            <span class="symbaroum-hud-storage-title symbaroum-hud-abilities-title">
              <i class="fa-solid fa-fingerprint" aria-hidden="true"></i>
              <strong>{{localize "SYMBAROUMHUD.Sections.Traits"}}</strong>
            </span>
            <button type="button" class="symbaroum-hud-storage-close symbaroum-hud-abilities-close"
              data-action="close-traits"
              data-tooltip="{{localize 'SYMBAROUMHUD.Actions.CloseTraits'}}"
              aria-label="{{localize 'SYMBAROUMHUD.Actions.CloseTraits'}}">
              <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
          </header>

          <div class="symbaroum-hud-abilities-body">
            <nav class="symbaroum-hud-abilities-sidebar" role="list"
              aria-label="{{localize 'SYMBAROUMHUD.Traits.List'}}">
              {{#each traits.items}}
                <button type="button" class="symbaroum-hud-ability-entry" role="listitem"
                  data-action="select-trait" data-item-id="{{id}}"
                  data-ability-id="{{id}}"
                  data-item-uuid="{{uuid}}"
                  data-active="{{active}}"
                  aria-pressed="{{active}}"
                  data-tooltip="{{name}}"
                  aria-label="{{name}}">
                  <img src="{{img}}" alt="">
                  <span>{{name}}</span>
                </button>
              {{else}}
                <span class="symbaroum-hud-abilities-empty">
                  <i class="fa-solid fa-fingerprint" aria-hidden="true"></i>
                  {{localize "SYMBAROUMHUD.Traits.Empty"}}
                </span>
              {{/each}}
            </nav>

            <article class="symbaroum-hud-ability-detail"
              aria-label="{{localize 'SYMBAROUMHUD.Traits.Detail'}}">
              {{#if traits.selected}}
                <header class="symbaroum-hud-ability-detail-header">
                  <img src="{{traits.selected.img}}" alt="">
                  <div class="symbaroum-hud-ability-detail-title">
                    <strong>{{traits.selected.name}}</strong>
                    {{#if traits.selected.reference}}
                      <span>{{localize "SYMBAROUMHUD.Abilities.Reference"}}: {{traits.selected.reference}}</span>
                    {{/if}}
                  </div>
                  <div class="symbaroum-hud-ability-detail-actions">
                    {{#if traits.selected.canUsePower}}
                      <button type="button" class="symbaroum-hud-ability-detail-action"
                        data-action="use-trait" data-item-id="{{traits.selected.id}}"
                        data-tooltip="{{localize 'SYMBAROUMHUD.Actions.UseTrait'}}"
                        aria-label="{{localize 'SYMBAROUMHUD.Actions.UseTrait'}}"
                        {{#unless traits.canUse}}disabled{{/unless}}>
                        <i class="fa-solid fa-dice-d20" aria-hidden="true"></i>
                        <span>{{localize "SYMBAROUMHUD.Actions.UseTrait"}}</span>
                      </button>
                    {{/if}}
                    <button type="button" class="symbaroum-hud-ability-detail-action"
                      data-action="open-ability" data-item-id="{{traits.selected.id}}"
                      data-tooltip="{{localize 'SYMBAROUMHUD.Actions.OpenAbility'}}"
                      aria-label="{{localize 'SYMBAROUMHUD.Actions.OpenAbility'}}">
                      <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i>
                    </button>
                  </div>
                </header>

                <section class="symbaroum-hud-ability-tab-panel" role="tabpanel"
                  data-ability-section="{{traits.selected.activeTab.id}}">
                  <header class="symbaroum-hud-ability-page-heading">
                    <div class="symbaroum-hud-ability-page-title">
                      <span aria-hidden="true"></span>
                      <h3>{{traits.selected.activeTab.label}}</h3>
                      <span aria-hidden="true"></span>
                    </div>
                  </header>
                  <div class="symbaroum-hud-ability-page-content">
                    {{#if traits.selected.activeTab.description}}
                      <div class="symbaroum-hud-ability-description">
                        {{{traits.selected.activeTab.description}}}
                      </div>
                    {{else}}
                      <span class="symbaroum-hud-ability-no-description">
                        {{localize "SYMBAROUMHUD.Abilities.NoDescription"}}
                      </span>
                    {{/if}}
                  </div>
                </section>
              {{else}}
                <span class="symbaroum-hud-ability-no-description">
                  {{localize "SYMBAROUMHUD.Traits.Empty"}}
                </span>
              {{/if}}
            </article>
          </div>
        </section>
      {{/if}}

    </div>

    <div class="symbaroum-hud-hotbar-row">
      {{#if ammoRecovery}}
        <button type="button" class="symbaroum-hud-ammo-recovery-slot"
          data-action="recover-ammo"
          data-tooltip="{{localize 'SYMBAROUMHUD.Actions.RecoverAmmo'}}: {{ammoRecovery.count}}"
          aria-label="{{localize 'SYMBAROUMHUD.Actions.RecoverAmmo'}}: {{ammoRecovery.count}}">
          <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
          <span aria-hidden="true">{{ammoRecovery.count}}</span>
        </button>
      {{/if}}
      {{#if readiness}}
        <button type="button" class="symbaroum-hud-readiness-slot"
          data-action="weapon-readiness" data-drawn="{{#if readiness.drawn}}true{{else}}false{{/if}}"
          data-tooltip="{{localize 'SYMBAROUMHUD.IndResources.Readiness'}}: {{readiness.drawn}}/{{readiness.total}}"
          aria-label="{{localize 'SYMBAROUMHUD.IndResources.Readiness'}}: {{readiness.drawn}}/{{readiness.total}}">
          <img src="{{readiness.icon}}" alt="" aria-hidden="true">
          <span aria-hidden="true">{{readiness.drawn}}/{{readiness.total}}</span>
        </button>
      {{/if}}
      <div class="symbaroum-hud-hotbar" data-symba-hotbar></div>
    </div>
  </div>
</div>
