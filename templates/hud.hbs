{{#if hasStatusSummary}}
  <aside class="symbaroum-hud-status-summary">
    {{#if effects}}
      <div class="symbaroum-hud-effects" role="list"
        aria-label="{{localize 'SYMBAROUMHUD.Sections.Effects'}}">
        {{#each effects}}
          <span class="symbaroum-hud-effect" role="listitem" data-effect-id="{{id}}"
            data-tooltip="{{name}}">
            <img src="{{img}}" alt="{{name}}">
          </span>
        {{/each}}
      </div>
    {{/if}}
    {{#if tactics}}
      <section class="symbaroum-hud-tactics" aria-label="{{localize 'BIO.TACTICS'}}">
        <h2><i class="fa-solid fa-chess-knight" aria-hidden="true"></i>{{localize "BIO.TACTICS"}}</h2>
        <div class="symbaroum-hud-tactics-content">{{{tactics.html}}}</div>
      </section>
    {{/if}}
  </aside>
{{/if}}

<div class="symbaroum-hud-card-row" data-symba-weapon-drawn="{{weaponDrawn}}"
  data-vitality-state="{{vitalityState}}">
  <div class="symbaroum-hud-hotbar-controls">
    <div class="symbaroum-hud-character-actions" aria-label="{{localize 'SYMBAROUMHUD.Actions.CharacterActions'}}">
      <button type="button" class="symbaroum-hud-character-action"
        data-action="death-test" data-tooltip="{{localize 'SYMBAROUMHUD.Actions.DeathTest'}}"
        aria-label="{{localize 'SYMBAROUMHUD.Actions.DeathTest'}}"
        {{#unless actions.deathTest}}disabled{{/unless}}>
        <i class="fa-solid fa-skull" aria-hidden="true"></i>
      </button>
      <button type="button" class="symbaroum-hud-character-action"
        data-action="death-recovery" data-tooltip="{{localize 'SYMBAROUMHUD.Actions.Recovery'}}"
        aria-label="{{localize 'SYMBAROUMHUD.Actions.Recovery'}}"
        {{#unless actions.recovery}}disabled{{/unless}}>
        <i class="fa-solid fa-heart" aria-hidden="true"></i>
      </button>
      <button type="button" class="symbaroum-hud-character-action"
        data-action="rest" data-tooltip="{{localize 'SYMBAROUMHUD.Actions.Rest'}}"
        aria-label="{{localize 'SYMBAROUMHUD.Actions.Rest'}}"
        {{#unless actions.rest}}disabled{{/unless}}>
        <i class="fa-solid fa-bed" aria-hidden="true"></i>
      </button>
    </div>

    <button type="button" class="ui-control fa-solid fa-volume icon"
      data-action="hotbar-control" data-hotbar-action="mute" data-symba-delayed-tooltip
      aria-label="{{localize 'HOTBAR.MUTE'}}"></button>
    <button type="button" class="ui-control fa-solid fa-bars icon"
      data-action="hotbar-control" data-hotbar-action="menu" data-symba-delayed-tooltip
      aria-label="{{localize 'HOTBAR.MENU'}}"></button>
    <button type="button"
      class="ui-control fa-solid {{#if playersHidden}}fa-users{{else}}fa-users-slash{{/if}} icon"
      data-action="toggle-players" data-symba-delayed-tooltip aria-pressed="{{playersHidden}}"
      aria-label="{{#if playersHidden}}{{localize 'SYMBAROUMHUD.Actions.ShowPlayers'}}{{else}}{{localize 'SYMBAROUMHUD.Actions.HidePlayers'}}{{/if}}"></button>
  </div>

  <div class="symbaroum-hud-character-card">
    <button type="button" class="symbaroum-hud-character-open" data-action="open-actor"
      data-tooltip="{{localize 'SYMBAROUMHUD.Actions.OpenActor'}}"
      aria-label="{{localize 'SYMBAROUMHUD.Actions.OpenActor'}}: {{actor.name}}">
      <img src="{{actor.img}}" alt="{{actor.name}}">
    </button>
    <div class="symbaroum-hud-character-name">
      <button type="button" class="symbaroum-hud-actor-cycle" data-action="previous-actor"
        data-tooltip="{{localize 'SYMBAROUMHUD.Actions.PreviousActor'}}"
        aria-label="{{localize 'SYMBAROUMHUD.Actions.PreviousActor'}}"
        {{#unless canCycleActor}}disabled{{/unless}}>
        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
      </button>
      <button type="button" class="symbaroum-hud-character-name-label" data-action="open-actor">
        {{actor.name}}
      </button>
      <button type="button" class="symbaroum-hud-actor-cycle" data-action="next-actor"
        data-tooltip="{{localize 'SYMBAROUMHUD.Actions.NextActor'}}"
        aria-label="{{localize 'SYMBAROUMHUD.Actions.NextActor'}}"
        {{#unless canCycleActor}}disabled{{/unless}}>
        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
      </button>
    </div>
    {{#if actor.deathFailures}}
      <span class="symbaroum-hud-death-failures" data-tooltip="{{localize 'TOOLTIP.DEATH_SKULLS'}}">
        {{#each actor.deathFailures}}
          <i class="fa-solid fa-skull" aria-hidden="true"></i>
        {{/each}}
      </span>
    {{/if}}
    <span class="symbaroum-hud-character-resources">
      <button type="button" class="symbaroum-hud-character-resource" data-resource="vitality"
        data-action="modify-vitality"
        data-tooltip="{{localize 'SYMBAROUMHUD.Vitality.Manage'}}: {{actor.vitality.value}}/{{actor.vitality.max}}"
        aria-label="{{localize 'SYMBAROUMHUD.Vitality.Manage'}}: {{actor.vitality.value}}/{{actor.vitality.max}}"
        style="--symbaroum-hud-resource-percent: {{actor.vitality.percent}}%;"
        {{#unless actions.vitality}}disabled{{/unless}}>
        <span class="symbaroum-hud-character-resource-fill" aria-hidden="true"></span>
        <span class="symbaroum-hud-character-resource-value">
          <i class="fa-solid fa-heart" aria-hidden="true"></i>
          <strong>{{actor.vitality.value}}</strong>/{{actor.vitality.max}}
        </span>
      </button>
      <button type="button" class="symbaroum-hud-character-resource" data-resource="corruption"
        data-action="modify-corruption"
        data-tooltip="{{localize 'SYMBAROUMHUD.Corruption.Manage'}}: {{actor.corruption.temporary}}+{{actor.corruption.permanent}}/{{actor.corruption.max}}"
        aria-label="{{localize 'SYMBAROUMHUD.Corruption.Manage'}}: {{actor.corruption.temporary}}+{{actor.corruption.permanent}}/{{actor.corruption.max}}"
        style="--symbaroum-hud-resource-percent: {{actor.corruption.percent}}%;"
        {{#unless actions.corruption}}disabled{{/unless}}>
        <span class="symbaroum-hud-character-resource-fill" aria-hidden="true"></span>
        <span class="symbaroum-hud-character-resource-value">
          <i class="fa-solid fa-droplet" aria-hidden="true"></i>
          <strong>{{actor.corruption.temporary}}+{{actor.corruption.permanent}}</strong>/{{actor.corruption.max}}
        </span>
      </button>
    </span>
  </div>

  <div class="symbaroum-hud-main-column">
    <div class="symbaroum-hud-upper-row">
      <section class="symbaroum-hud-attributes" aria-label="{{localize 'SYMBAROUMHUD.Sections.Attributes'}}">
        {{#each attributes}}
          <button type="button" class="symbaroum-hud-attribute"
            data-action="roll-attribute" data-attribute="{{id}}"
            data-tooltip="{{label}}: {{value}}" aria-label="{{label}}: {{value}}"
            {{#unless ../actions.attributes}}disabled{{/unless}}>
            <i class="fa-solid {{icon}}" aria-hidden="true"></i>
            <span class="symbaroum-hud-attribute-name">{{label}}</span>
            <strong>{{value}}</strong>
          </button>
        {{/each}}
      </section>

      <section class="symbaroum-hud-info-panel" aria-label="{{localize 'SYMBAROUMHUD.Info.Title'}}">
        <div class="symbaroum-hud-info-entry"
          data-tooltip="{{localize 'SYMBAROUMHUD.Info.Defense'}}: {{info.defense}}"
          aria-label="{{localize 'SYMBAROUMHUD.Info.Defense'}}: {{info.defense}}">
          <button type="button" class="symbaroum-hud-info-action" data-action="roll-defense"
            data-tooltip="{{localize 'SYMBAROUMHUD.Actions.RollDefense'}}"
            aria-label="{{localize 'SYMBAROUMHUD.Actions.RollDefense'}}"
            {{#unless actions.defense}}disabled{{/unless}}>
            <i class="fa-solid fa-shield" aria-hidden="true"></i>
          </button>
          <strong>{{info.defense}}</strong>
        </div>

        <div class="symbaroum-hud-info-entry"
          data-tooltip="{{localize 'SYMBAROUMHUD.Info.Armor'}} — {{info.armorName}}: {{info.armor}}"
          aria-label="{{localize 'SYMBAROUMHUD.Info.Armor'}}: {{info.armor}}">
          <i class="fa-solid fa-vest" aria-hidden="true"></i>
          <strong>{{info.armor}}</strong>
        </div>

        {{#if info.rations}}
          <div class="symbaroum-hud-info-entry"
            data-tooltip="{{localize 'SYMBAROUMHUD.Info.Rations'}}: {{info.rations.quantity}} — {{info.rations.usesRemaining}}/{{info.rations.usesPerUnit}}"
            aria-label="{{localize 'SYMBAROUMHUD.Info.Rations'}}: {{info.rations.quantity}}, {{info.rations.usesRemaining}}/{{info.rations.usesPerUnit}}">
            <button type="button" class="symbaroum-hud-info-action" data-action="consume-ration"
              data-tooltip="{{localize 'SYMBAROUMHUD.Actions.ConsumeRation'}}"
              aria-label="{{localize 'SYMBAROUMHUD.Actions.ConsumeRation'}}"
              {{#unless actions.rations}}disabled{{/unless}}>
              <i class="fa-solid fa-bread-slice" aria-hidden="true"></i>
            </button>
            <strong>{{info.rations.quantity}} {{info.rations.usesRemaining}}/{{info.rations.usesPerUnit}}</strong>
          </div>
        {{/if}}

        {{#if info.quiver}}
          <div class="symbaroum-hud-info-entry"
            data-tooltip="{{info.quiver.name}}: {{info.quiver.loaded}}/{{info.quiver.capacity}}"
            aria-label="{{localize 'SYMBAROUMHUD.Info.Quiver'}}: {{info.quiver.loaded}}">
            <i class="fa-solid fa-bullseye-arrow" aria-hidden="true"></i>
            <strong>{{info.quiver.loaded}}</strong>
          </div>
        {{/if}}
      </section>

      {{#if showEconomy}}
      <section class="symbaroum-hud-economy-panel" aria-label="{{localize 'SYMBAROUMHUD.Info.InventoryStatus'}}">
        <button type="button" class="symbaroum-hud-economy-entry symbaroum-hud-economy-action"
          data-action="open-money"
          data-tooltip="{{localize 'SYMBAROUMHUD.Actions.ManageMoney'}} - {{localize 'MONEY.THALER'}}: {{info.money.thaler}}"
          aria-label="{{localize 'SYMBAROUMHUD.Actions.ManageMoney'}} - {{localize 'MONEY.THALER'}}: {{info.money.thaler}}">
          <i class="fa-solid fa-coins" aria-hidden="true"></i>
          <strong>{{info.money.thaler}}</strong>
          <small>T</small>
        </button>
        <button type="button" class="symbaroum-hud-economy-entry symbaroum-hud-economy-action"
          data-action="open-money"
          data-tooltip="{{localize 'SYMBAROUMHUD.Actions.ManageMoney'}} - {{localize 'MONEY.SHILLING'}}: {{info.money.shilling}}"
          aria-label="{{localize 'SYMBAROUMHUD.Actions.ManageMoney'}} - {{localize 'MONEY.SHILLING'}}: {{info.money.shilling}}">
          <i class="fa-solid fa-coin" aria-hidden="true"></i>
          <strong>{{info.money.shilling}}</strong>
          <small>X</small>
        </button>
        <button type="button" class="symbaroum-hud-economy-entry symbaroum-hud-economy-action"
          data-action="open-money"
          data-tooltip="{{localize 'SYMBAROUMHUD.Actions.ManageMoney'}} - {{localize 'MONEY.ORTEG'}}: {{info.money.orteg}}"
          aria-label="{{localize 'SYMBAROUMHUD.Actions.ManageMoney'}} - {{localize 'MONEY.ORTEG'}}: {{info.money.orteg}}">
          <i class="fa-solid fa-circle" aria-hidden="true"></i>
          <strong>{{info.money.orteg}}</strong>
          <small>O</small>
        </button>
        <div class="symbaroum-hud-economy-entry"
          data-overloaded="{{info.load.overloaded}}"
          data-immobilized="{{info.load.immobilized}}"
          data-tooltip="{{localize 'SYMBAROUMHUD.Storage.Weight'}}: {{#if info.load}}{{info.load.current}}/{{info.load.capacity}}{{else}}—{{/if}}"
          aria-label="{{localize 'SYMBAROUMHUD.Storage.Weight'}}: {{#if info.load}}{{info.load.current}}/{{info.load.capacity}}{{else}}—{{/if}}">
          <i class="fa-solid fa-weight-hanging" aria-hidden="true"></i>
          <strong>{{#if info.load}}{{info.load.current}}/{{info.load.capacity}}{{else}}—{{/if}}</strong>
        </div>
      </section>
      {{/if}}

      <div class="symbaroum-hud-action-area"
        data-has-experience="{{knowledge.showExperience}}"
        data-has-knowledge="{{knowledge.available}}">
        {{#if knowledge.showExperience}}
        <button type="button" class="symbaroum-hud-experience-panel"
          data-action="reroll-cost"
          data-tooltip="{{localize 'SYMBAROUMHUD.Info.Experience'}}: {{info.experience.available}}/{{info.experience.total}}"
          aria-label="{{localize 'SYMBAROUMHUD.RerollCost.Title'}}"
          {{#unless actions.rerollCost}}disabled{{/unless}}>
          <i class="fa-solid fa-star" aria-hidden="true"></i>
          <span>{{localize "SYMBAROUMHUD.Info.ExperienceShort"}}</span>
          <strong>{{info.experience.available}}/{{info.experience.total}}</strong>
        </button>
        {{/if}}

        <div class="symbaroum-hud-panel-stack">
        <button type="button" class="symbaroum-hud-panel-toggle symbaroum-hud-attacks-toggle"
          data-action="toggle-attacks" data-panel="attacks"
          data-weapon-drop="{{attacks.canUse}}"
          data-open="{{attacks.open}}" aria-expanded="{{attacks.open}}"
          aria-controls="symbaroum-hud-attacks-panel"
          data-tooltip="{{localize 'SYMBAROUMHUD.Sections.Attacks'}}"
          aria-label="{{localize 'SYMBAROUMHUD.Sections.Attacks'}}">
          <i class="fa-solid fa-sword" aria-hidden="true"></i>
        </button>

        {{#if storage}}
          <button type="button" class="symbaroum-hud-panel-toggle symbaroum-hud-storage-toggle"
            data-action="toggle-storage" data-open="{{storage.open}}"
            aria-expanded="{{storage.open}}" aria-controls="symbaroum-hud-storage-panel"
            data-tooltip="{{localize 'SYMBAROUMHUD.Storage.Open'}}"
            aria-label="{{localize 'SYMBAROUMHUD.Storage.Open'}}">
            <i class="fa-solid fa-backpack" aria-hidden="true"></i>
          </button>
        {{/if}}
        </div>

      {{#if attacks.open}}
        <section id="symbaroum-hud-attacks-panel" class="symbaroum-hud-attacks-panel"
          aria-label="{{localize 'SYMBAROUMHUD.Sections.Attacks'}}">
          <header class="symbaroum-hud-storage-header symbaroum-hud-attacks-header">
            <span class="symbaroum-hud-storage-title symbaroum-hud-attacks-title">
              <i class="fa-solid fa-sword" aria-hidden="true"></i>
              <strong>{{localize "SYMBAROUMHUD.Sections.Attacks"}}</strong>
            </span>
            <button type="button" class="symbaroum-hud-storage-close symbaroum-hud-attacks-close"
              data-action="close-attacks"
              data-tooltip="{{localize 'SYMBAROUMHUD.Actions.CloseAttacks'}}"
              aria-label="{{localize 'SYMBAROUMHUD.Actions.CloseAttacks'}}">
              <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
          </header>

          <ul class="symbaroum-hud-attacks-body"
            aria-label="{{localize 'SYMBAROUMHUD.Sections.Weapons'}}">
            {{#each attacks.items}}
              <li class="symbaroum-hud-attack-slot">
                <button type="button" class="symbaroum-hud-attack-entry"
                  data-action="roll-weapon" data-item-id="{{id}}"
                  data-item-uuid="{{uuid}}"
                  data-weapon-draggable="{{draggable}}"
                  data-readiness-known="{{readinessKnown}}"
                  data-drawn="{{drawn}}"
                  data-tooltip="{{localize 'SYMBAROUMHUD.Actions.RollWeapon'}}: {{name}}{{#if readinessKnown}} — {{readinessLabel}}{{/if}}"
                  aria-label="{{localize 'SYMBAROUMHUD.Actions.RollWeapon'}}: {{name}}{{#if readinessKnown}} — {{readinessLabel}}{{/if}}"
                  {{#if draggable}}draggable="true"{{/if}}
                  {{#unless ../attacks.canUse}}disabled{{/unless}}>
                  <img src="{{img}}" alt="">
                  <span class="symbaroum-hud-attack-label">
                    <strong>{{name}}</strong>
                    <i class="fa-solid fa-dice-d20" aria-hidden="true"></i>
                  </span>
                </button>
                {{#if readinessKnown}}
                  <button type="button" class="symbaroum-hud-attack-readiness"
                    data-drawn="{{drawn}}" data-item-id="{{id}}"
                    {{#if drawn}}data-action="sheathe-weapon"{{/if}}
                    data-tooltip="{{#if drawn}}{{localize 'SYMBAROUMHUD.Attacks.SheatheAction'}}: {{name}}{{else}}{{readinessLabel}}{{/if}}"
                    aria-label="{{#if drawn}}{{localize 'SYMBAROUMHUD.Attacks.SheatheAction'}}: {{name}}{{else}}{{readinessLabel}}{{/if}}"
                    {{#if drawn}}{{#unless ../attacks.canUse}}disabled{{/unless}}{{else}}disabled{{/if}}>
                    <i class="fa-solid {{#if drawn}}fa-hand-fist{{else}}fa-hand{{/if}}" aria-hidden="true"></i>
                    <span>{{readinessLabel}}</span>
                  </button>
                {{/if}}
              </li>
            {{else}}
              <li class="symbaroum-hud-attacks-empty">
                <i class="fa-solid fa-sword" aria-hidden="true"></i>
                {{localize "SYMBAROUMHUD.Attacks.Empty"}}
              </li>
            {{/each}}
          </ul>
        </section>
      {{/if}}

      {{#if storage}}
        {{#if storage.open}}
          <section id="symbaroum-hud-storage-panel" class="symbaroum-hud-storage-panel"
            aria-label="{{storage.name}}">
            <header class="symbaroum-hud-storage-header">
              <span class="symbaroum-hud-storage-title">
                {{#if storage.quiverSelected}}
                  <img class="symbaroum-hud-storage-title-img" src="{{storage.img}}" alt="">
                {{else}}
                  <i class="fa-solid {{#if storage.containerSelected}}fa-backpack{{else}}fa-boxes-stacked{{/if}}"
                    aria-hidden="true"></i>
                {{/if}}
                <strong>{{storage.name}}</strong>
                {{#if storage.inventoryActive}}
                  {{#if storage.load}}
                    <small class="symbaroum-hud-storage-load"
                      data-overloaded="{{storage.load.overloaded}}"
                      data-immobilized="{{storage.load.immobilized}}"
                      data-tooltip="{{localize 'SYMBAROUMHUD.Storage.Weight'}}: {{storage.load.current}}/{{storage.load.capacity}} - {{localize 'SYMBAROUMHUD.Storage.Overload'}}: {{storage.load.penalty}}">
                      <span>
                        <i class="fa-solid fa-weight-hanging" aria-hidden="true"></i>
                        {{localize "SYMBAROUMHUD.Storage.Weight"}}: {{storage.load.current}}/{{storage.load.capacity}}
                      </span>
                      <span>
                        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                        {{localize "SYMBAROUMHUD.Storage.Overload"}}: {{storage.load.penalty}}
                      </span>
                      {{#if storage.load.immobilized}}
                        <span>{{localize "SYMBAROUMHUD.Storage.Immobilized"}}</span>
                      {{/if}}
                    </small>
                  {{/if}}
                {{/if}}
                {{#if storage.capacity}}
                  <small>{{localize "SYMBAROUMHUD.Storage.Capacity"}}: {{storage.capacity}}</small>
                {{/if}}
              </span>
              <span class="symbaroum-hud-storage-header-actions">
                <button type="button" class="symbaroum-hud-storage-view-toggle"
                  data-action="toggle-storage-view"
                  data-view-mode="{{storage.viewMode}}"
                  data-tooltip="{{#if storage.listView}}{{localize 'SYMBAROUMHUD.Storage.ViewAsGrid'}}{{else}}{{localize 'SYMBAROUMHUD.Storage.ViewAsList'}}{{/if}}"
                  aria-label="{{#if storage.listView}}{{localize 'SYMBAROUMHUD.Storage.ViewAsGrid'}}{{else}}{{localize 'SYMBAROUMHUD.Storage.ViewAsList'}}{{/if}}">
                  <i class="fa-solid {{#if storage.listView}}fa-table-cells-large{{else}}fa-list{{/if}}"
                    aria-hidden="true"></i>
                </button>
                <button type="button" class="symbaroum-hud-storage-close"
                  data-action="close-storage"
                  data-tooltip="{{localize 'SYMBAROUMHUD.Storage.Close'}}"
                  aria-label="{{localize 'SYMBAROUMHUD.Storage.Close'}}">
                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
              </span>
            </header>

            <div class="symbaroum-hud-storage-body">
              <nav class="symbaroum-hud-storage-sidebar"
                aria-label="{{localize 'SYMBAROUMHUD.Storage.Sources'}}">
                <button type="button" data-action="select-storage-container"
                  data-container-id="" data-active="{{storage.inventoryActive}}"
                  data-storage-withdraw-zone="inventory"
                  aria-pressed="{{storage.inventoryActive}}"
                  data-tooltip="{{localize 'SYMBAROUMHUD.Storage.Inventory'}}"
                  aria-label="{{localize 'SYMBAROUMHUD.Storage.Inventory'}}">
                  <i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i>
                  <span>{{localize "SYMBAROUMHUD.Storage.Inventory"}}</span>
                  {{#if storage.pockets}}
                    <small>{{localize "SYMBAROUMHUD.Storage.Pockets"}}</small>
                  {{/if}}
                </button>

                {{#each storage.quivers}}
                  <button type="button" data-action="select-storage-container"
                    data-container-id="{{storageId}}" data-active="{{active}}"
                    data-storage-drop-quiver="{{id}}"
                    data-storage-delete-container="{{id}}"
                    aria-pressed="{{active}}"
                    data-tooltip="{{name}}"
                    aria-label="{{name}}">
                    <img src="{{img}}" alt="">
                    <span>{{name}}</span>
                    <small>{{loaded}}/{{capacity}}</small>
                  </button>
                {{/each}}

                {{#each storage.containers}}
                  <button type="button" data-action="select-storage-container"
                    data-container-id="{{id}}" data-active="{{active}}"
                    data-storage-drop-container="{{id}}"
                    data-storage-delete-container="{{id}}"
                    aria-pressed="{{active}}" data-tooltip="{{name}}"
                    aria-label="{{name}}">
                    <img src="{{img}}" alt="">
                    <span>{{name}}</span>
                    {{#if capacity}}<small>{{capacity}}</small>{{/if}}
                  </button>
                {{/each}}

                {{#unless storage.hasContainers}}
                  <span class="symbaroum-hud-storage-pockets-note">
                    <i class="fa-solid fa-pockets" aria-hidden="true"></i>
                    {{localize "SYMBAROUMHUD.Storage.NoBackpackShort"}}
                  </span>
                {{/unless}}
              </nav>

              {{#if storage.quiverSelected}}
                <div class="symbaroum-hud-quiver-page">
                  <section class="symbaroum-hud-quiver-detail"
                    data-storage-drop-quiver="{{storage.quiver.id}}"
                    aria-label="{{storage.quiver.name}}">
                    <img src="{{storage.quiver.img}}" alt="">
                    <div class="symbaroum-hud-quiver-detail-info">
                      <strong>{{storage.quiver.name}}</strong>
                      <span>
                        <i class="fa-solid fa-arrow-down-short-wide" aria-hidden="true"></i>
                        {{localize "SYMBAROUMHUD.Storage.Loaded"}}: {{storage.quiver.loaded}}/{{storage.quiver.capacity}}
                      </span>
                      <span>
                        <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                        {{localize "SYMBAROUMHUD.Storage.Quantity"}}: {{storage.quiver.quantity}}
                      </span>
                      <span>
                        <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                        {{localize "SYMBAROUMHUD.Storage.Remaining"}}: {{storage.quiver.remaining}}
                      </span>
                      {{#if storage.quiver.loadedItems}}
                        <div class="symbaroum-hud-quiver-loaded-list">
                          {{#each storage.quiver.loadedItems}}
                            <span>
                              <img src="{{img}}" alt="">
                              {{name}} ×{{quantity}}
                            </span>
                          {{/each}}
                        </div>
                      {{/if}}
                      <button type="button" class="symbaroum-hud-quiver-reload"
                        data-action="reload-quiver" data-quiver-id="{{storage.quiver.id}}"
                        data-tooltip="{{localize 'SYMBAROUMHUD.Storage.ReloadQuiver'}}"
                        aria-label="{{localize 'SYMBAROUMHUD.Storage.ReloadQuiver'}}">
