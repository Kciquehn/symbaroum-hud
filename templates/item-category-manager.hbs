<div class="symbaroum-hud-item-category-manager">
  <header class="symbaroum-hud-item-category-manager-heading">
    <i class="fa-solid fa-tags" aria-hidden="true"></i>
    <span>
      <h1>{{localize "SYMBAROUMHUD.ItemCategoryManager.Heading"}}</h1>
      <p>{{localize "SYMBAROUMHUD.ItemCategoryManager.Introduction"}}</p>
    </span>
    <dl>
      <div><dt>{{localize "SYMBAROUMHUD.ItemCategoryManager.Total"}}</dt><dd>{{count}}</dd></div>
      <div><dt>{{localize "SYMBAROUMHUD.ItemCategoryManager.Automatic"}}</dt><dd>{{automaticCount}}</dd></div>
      <div><dt>{{localize "SYMBAROUMHUD.ItemCategoryManager.Manual"}}</dt><dd>{{manualCount}}</dd></div>
    </dl>
  </header>

  <section class="symbaroum-hud-item-category-manager-filters">
    <label class="symbaroum-hud-item-category-manager-search">
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input type="search" data-item-category-search
        placeholder="{{localize 'SYMBAROUMHUD.ItemCategoryManager.Search'}}"
        aria-label="{{localize 'SYMBAROUMHUD.ItemCategoryManager.Search'}}">
    </label>
    <label>
      <span>{{localize "SYMBAROUMHUD.ItemCategoryManager.ItemType"}}</span>
      <select data-item-category-type>
        <option value="all">{{localize "SYMBAROUMHUD.ItemCategoryManager.AllTypes"}}</option>
        {{#each types}}<option value="{{id}}">{{label}} ({{count}})</option>{{/each}}
      </select>
    </label>
    <label>
      <span>{{localize "SYMBAROUMHUD.ItemCategoryManager.Classification"}}</span>
      <select data-item-category-mode>
        <option value="all">{{localize "SYMBAROUMHUD.ItemCategoryManager.AllClassifications"}}</option>
        <option value="automatic">{{localize "SYMBAROUMHUD.ItemCategoryManager.Automatic"}}</option>
        <option value="manual">{{localize "SYMBAROUMHUD.ItemCategoryManager.Manual"}}</option>
      </select>
    </label>
    <strong><span data-item-category-visible>{{count}}</span> {{localize "SYMBAROUMHUD.ItemCategoryManager.Found"}}</strong>
  </section>

  <main class="symbaroum-hud-item-category-manager-list">
    {{#each items}}
      <article data-item-category-entry data-entry-id="{{id}}" data-entry-kind="{{kind}}" data-type="{{type}}"
        data-mode="{{mode}}" data-search="{{searchText}}">
        <img src="{{img}}" alt="">
        <div class="symbaroum-hud-item-category-manager-item">
          <header>
            {{#if canOpen}}
              <button type="button" data-action="open-item" data-entry-id="{{id}}">{{name}}</button>
            {{else}}
              <strong>{{name}}</strong>
            {{/if}}
            <small>{{typeLabel}}</small>
            <em data-manual="{{manual}}">
              <i class="fa-solid {{#if manual}}fa-pen{{else}}fa-wand-magic-sparkles{{/if}}" aria-hidden="true"></i>
              {{#if manual}}{{localize "SYMBAROUMHUD.ItemCategoryManager.Manual"}}{{else}}{{localize "SYMBAROUMHUD.ItemCategoryManager.Automatic"}}{{/if}}
            </em>
          </header>
          <div class="symbaroum-hud-item-category-manager-tags">
            {{#each categories}}<span data-category="{{id}}">{{label}}</span>{{else}}<span data-empty="true">{{localize "SYMBAROUMHUD.ItemCategoryManager.NoCategories"}}</span>{{/each}}
          </div>
        </div>
        <button type="button" class="symbaroum-hud-item-category-manager-edit"
          data-action="edit-categories" data-entry-id="{{id}}" data-entry-kind="{{kind}}">
          <i class="fa-solid fa-tags" aria-hidden="true"></i>
          {{localize "SYMBAROUMHUD.ItemCategoryManager.Edit"}}
        </button>
      </article>
    {{/each}}
    <div class="symbaroum-hud-item-category-manager-empty" data-item-category-empty hidden>
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <strong>{{localize "SYMBAROUMHUD.ItemCategoryManager.Empty"}}</strong>
      <span>{{localize "SYMBAROUMHUD.ItemCategoryManager.EmptyHint"}}</span>
    </div>
  </main>
</div>
