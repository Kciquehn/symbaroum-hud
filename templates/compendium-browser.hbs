<div class="symbaroum-hud-browser-shell" data-browser-mode="{{#if shop.active}}shop{{else}}browser{{/if}}"
  data-shop-closed="{{shop.closed}}" data-shop-view="{{shop.view}}">
  <header class="symbaroum-hud-browser-heading">
    <div>
      {{#if shop.active}}
        {{#if shop.directory.active}}
          <i class="fa-solid fa-shop" aria-hidden="true"></i>
        {{else}}
          <button type="button" class="symbaroum-hud-shop-heading-back"
            data-action="show-shop-directory"
            data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.BackToDirectory'}}"
            aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.BackToDirectory'}}">
            <i class="fa-solid fa-shop symbaroum-hud-shop-heading-store" aria-hidden="true"></i>
            <i class="fa-solid fa-arrow-left symbaroum-hud-shop-heading-arrow" aria-hidden="true"></i>
          </button>
        {{/if}}
      {{else}}
        <i class="fa-solid fa-book-open" aria-hidden="true"></i>
      {{/if}}
      <span>
        {{#if shop.directory.active}}
          <strong>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.DirectoryTitle"}}</strong>
        {{else}}
          {{#if shop.builder.active}}
            {{#if shop.builder.editable}}
              <label class="symbaroum-hud-shop-name-field">
                <input type="text" data-shop-name value="{{shop.builder.name}}"
                  placeholder="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.StoreNamePlaceholder'}}"
                  aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.StoreNameLabel'}}"
                  maxlength="80" autocomplete="off">
              </label>
            {{else}}
              <strong>{{shop.builder.name}}</strong>
            {{/if}}
          {{else}}
            <strong>{{#if shop.weaponOnly}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.WeaponTitle"}}{{else}}{{#if shop.active}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.Title"}}{{else}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Title"}}{{/if}}{{/if}}</strong>
          {{/if}}
        {{/if}}
        <small>{{#if shop.directory.active}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.DirectorySubtitle"}}{{else}}{{#if shop.builder.active}}{{#if shop.builder.editable}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StoreBuilderSubtitle"}}{{else}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StorefrontSubtitle"}}{{/if}}{{else}}{{#if shop.weaponOnly}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.WeaponSubtitle"}}{{else}}{{#if shop.active}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.Subtitle"}}{{else}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Subtitle"}}{{/if}}{{/if}}{{/if}}{{/if}}</small>
      </span>
    </div>
    <div class="symbaroum-hud-browser-heading-actions">
      {{#if shop.directory.active}}
        {{#if shop.location.canManage}}
          {{#if shop.location.active}}
            <button type="button" class="symbaroum-hud-delete-location-button"
              data-action="delete-active-location"
              data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.RemoveLocation'}}"
              aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.RemoveLocation'}}">
              <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
            </button>
          {{/if}}
          <button type="button" data-action="configure-shop-locations"
            data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.ConfigureLocations'}}"
            aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.ConfigureLocations'}}">
            <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
          </button>
        {{/if}}
      {{/if}}
      {{#if shop.builder.editable}}
        {{#if shop.builder.managingStock}}
          <button type="button" class="symbaroum-hud-shop-service-create"
            data-action="create-service"
            aria-label="{{localize 'SYMBAROUMHUD.Services.Create'}}"
            data-tooltip="{{localize 'SYMBAROUMHUD.Services.Create'}}">
            <i class="fa-solid fa-bell-concierge" aria-hidden="true"></i>
          </button>
        {{/if}}
        <button type="button" class="symbaroum-hud-shop-stock-toggle"
          data-action="toggle-stock-manager" data-active="{{shop.builder.managingStock}}"
          aria-pressed="{{shop.builder.managingStock}}"
          aria-label="{{#if shop.builder.managingStock}}{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.StockDone'}}{{else}}{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.StockManage'}}{{/if}}"
          data-tooltip="{{#if shop.builder.managingStock}}{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.StockDone'}}{{else}}{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.StockManage'}}{{/if}}">
          <i class="fa-solid {{#if shop.builder.managingStock}}fa-check{{else}}fa-boxes-stacked{{/if}}" aria-hidden="true"></i>
        </button>
      {{/if}}
      {{#if shop.canConfigurePricing}}
        <button type="button" data-action="configure-shop-pricing"
          data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.ConfigurePricing'}}"
          aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.ConfigurePricing'}}">
          <i class="fa-solid fa-sliders" aria-hidden="true"></i>
        </button>
      {{/if}}
      {{#if shop.showAvailabilityToggle}}
        <button type="button" class="symbaroum-hud-general-store-toggle"
          data-action="{{#if shop.builder.active}}toggle-custom-store{{else}}toggle-general-store{{/if}}"
          data-open="{{shop.open}}" {{#unless shop.canManageAvailability}}disabled{{/unless}}
          data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.ToggleAvailability'}}"
          aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.ToggleAvailability'}}"
          aria-pressed="{{shop.open}}">
          <i class="fa-solid {{#if shop.open}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" aria-hidden="true"></i>
          <span>{{#if shop.open}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StoreOpen"}}{{else}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StoreClosed"}}{{/if}}</span>
        </button>
      {{/if}}
      <button type="button" data-action="configure-sources"
        data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.ConfigureSources'}}"
        aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.ConfigureSources'}}">
        <i class="fa-solid fa-gear" aria-hidden="true"></i>
      </button>
    </div>
  </header>

  {{#if shop.directory.active}}
    <section class="symbaroum-hud-shop-directory" aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.DirectoryTitle'}}">
      <header>
        <h2>{{#if shop.location.active}}{{shop.location.name}}{{else}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.DirectoryHeading"}}{{/if}}</h2>
        <p>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.DirectoryHint"}}</p>
        {{#if shop.location.canManage}}
          <label class="symbaroum-hud-shop-location-picker">
            <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
            <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.ActiveLocation"}}</span>
            <select data-shop-location-select>
              <option value="" {{#unless shop.location.active}}selected{{/unless}}>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.NoActiveLocation"}}</option>
              {{#each shop.location.options}}
                <option value="{{id}}" {{#if active}}selected{{/if}}>{{name}}</option>
              {{/each}}
              <option value="__create_shop_location__">{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.CreateLocation"}}</option>
            </select>
          </label>
          {{#if shop.location.active}}
            <button type="button" class="symbaroum-hud-shop-generate-official"
              data-action="generate-official-shops">
              <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
              {{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.GenerateOfficialStores"}}
            </button>
          {{/if}}
        {{else}}
          {{#if shop.location.active}}
            <div class="symbaroum-hud-shop-location-label">
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <span>{{shop.location.name}}</span>
            </div>
          {{/if}}
        {{/if}}
      </header>
      <div class="symbaroum-hud-shop-directory-grid">
        {{#each shop.directory.stores}}
          <div class="symbaroum-hud-shop-directory-card-frame" data-open="{{open}}"
            data-shop-directory-id="{{id}}" data-general="{{general}}">
            <button type="button" class="symbaroum-hud-shop-directory-card" data-action="select-shop"
              data-shop-id="{{id}}" data-open="{{open}}" aria-label="{{name}}">
              <span class="symbaroum-hud-shop-directory-image" data-general="{{general}}" data-has-image="{{hasImage}}"
                style="{{imageStyle}}">
                {{#if general}}
                  <i class="fa-solid {{icon}}" aria-hidden="true"></i>
                {{else}}
                  {{#if hasImage}}
                    <img src="{{img}}" alt="">
                  {{else}}
                    <i class="fa-solid {{icon}}" aria-hidden="true"></i>
                  {{/if}}
                {{/if}}
              </span>
              {{#unless open}}
                <em class="symbaroum-hud-shop-directory-closed" data-open="false">
                  <i class="fa-solid fa-door-closed" aria-hidden="true"></i>
                  {{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StoreClosed"}}
                </em>
              {{/unless}}
              <span class="symbaroum-hud-shop-directory-card-content">
                <strong>{{name}}</strong>
                <small>{{description}}</small>
                {{#unless general}}
                  <b><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i> {{stockCount}} {{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockedItems"}}</b>
                {{/unless}}
              </span>
            </button>
            {{#if ../shop.directory.canManageAvailability}}
              <button type="button" class="symbaroum-hud-shop-directory-availability"
                data-action="toggle-directory-store" data-shop-id="{{id}}" data-general="{{general}}"
                data-open="{{open}}" aria-pressed="{{open}}"
                aria-label="{{#if open}}{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.QuickCloseStore'}}{{else}}{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.QuickOpenStore'}}{{/if}}"
                data-tooltip="{{#if open}}{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.QuickCloseStore'}}{{else}}{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.QuickOpenStore'}}{{/if}}">
                <i class="fa-solid {{#if open}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" aria-hidden="true"></i>
              </button>
            {{/if}}
          </div>
        {{/each}}
        {{#if shop.directory.canCreate}}
          <button type="button" class="symbaroum-hud-shop-directory-card symbaroum-hud-shop-directory-create"
            data-action="create-shop">
            <span class="symbaroum-hud-shop-directory-image">
              <i class="fa-solid fa-plus" aria-hidden="true"></i>
            </span>
            <span class="symbaroum-hud-shop-directory-card-content">
              <strong>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.CreateStore"}}</strong>
              <small>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.CreateStoreHint"}}</small>
            </span>
          </button>
        {{/if}}
      </div>
      {{#if shop.directory.empty}}
        <div class="symbaroum-hud-shop-location-empty">
          <i class="fa-solid fa-signs-post" aria-hidden="true"></i>
          <strong>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.LocationEmpty"}}</strong>
          <small>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.LocationEmptyHint"}}</small>
        </div>
      {{/if}}
    </section>
  {{/if}}

  {{#if shop.showClosedNotice}}
    <section class="symbaroum-hud-shop-closed-notice" role="status">
      <i class="fa-solid fa-store-slash" aria-hidden="true"></i>
      <h2>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.NoStoreAvailable"}}</h2>
      <p>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.NoStoreAvailableHint"}}</p>
    </section>
  {{/if}}

  {{#if shop.builder.visible}}
    <section class="symbaroum-hud-shop-builder" data-shop-builder
      data-managing-stock="{{shop.builder.managingStock}}"
      aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CreateStore'}}">
      <div class="symbaroum-hud-shop-builder-canvas">
        {{#if shop.builder.managingStock}}
          <aside class="symbaroum-hud-shop-stock-generator-panel">
            <form class="symbaroum-hud-shop-generator-form" data-shop-generator-form>
              <header>
                <i class="fa-solid fa-dice" aria-hidden="true"></i>
                <span>
                  <strong>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockGenerator"}}</strong>
                  <small>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockGeneratorHint"}}</small>
                </span>
              </header>
              <section class="symbaroum-hud-shop-generator-categories">
                <header>
                  <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.GenerationCategories"}}</span>
                  <small><b data-stock-generator-selected-count>{{shop.builder.generator.selectedCount}}</b> {{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.SelectedCategories"}}</small>
                </header>
                <div>
                  {{#each shop.builder.generator.categories}}
                    <label style="--category-depth: {{depth}}">
                      <input type="checkbox" data-stock-generator-category value="{{id}}" {{#if checked}}checked{{/if}}>
                      <i class="fa-solid {{icon}}" aria-hidden="true"></i>
                      <span>{{label}}</span>
                    </label>
                  {{/each}}
                </div>
              </section>
              <label>
                <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.GenerationSeed"}}</span>
                <input type="text" data-stock-generator-seed value="{{shop.builder.generator.seed}}"
                  maxlength="120" required>
                <small>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.GenerationSeedHint"}}</small>
              </label>
              <label class="symbaroum-hud-shop-generator-check">
                <input type="checkbox" data-stock-generator-replace {{#if shop.builder.generator.replace}}checked{{/if}}>
                <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.ReplaceStock"}}</span>
              </label>
              <div class="symbaroum-hud-shop-generator-actions">
                <button type="button" data-action="configure-stock-rules">
                  <i class="fa-solid fa-percent" aria-hidden="true"></i>
                  {{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.ConfigureStockRules"}}
                </button>
                <button type="button" data-action="generate-shop-stock-inline">
                  <i class="fa-solid fa-dice" aria-hidden="true"></i>
                  {{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.GenerateStock"}}
                </button>
              </div>
            </form>
          </aside>
        {{/if}}
        <aside class="symbaroum-hud-shop-merchant-profile">
          {{#if shop.builder.editable}}
            <div class="symbaroum-hud-shop-merchant-image-editor"
              data-shop-image-editor data-editing="{{shop.builder.imageEditing}}"
              style="{{shop.builder.imageStyle}}">
              <div class="symbaroum-hud-shop-merchant-image" data-shop-image-surface
                tabindex="{{#if shop.builder.imageEditing}}0{{else}}-1{{/if}}"
                aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.ImagePositionHint'}}">
                <img src="{{shop.builder.img}}" alt="">
              </div>
              <button type="button" class="symbaroum-hud-shop-merchant-image-change"
                data-action="choose-shop-image"
                data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.ChooseImage'}}"
                aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.ChooseImage'}}">
                <i class="fa-solid fa-image" aria-hidden="true"></i>
                <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.ChangeImage"}}</span>
              </button>
              <button type="button" class="symbaroum-hud-shop-merchant-image-adjust"
                data-action="toggle-shop-image-editor"
                data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.ImagePositionHint'}}"
                aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.AdjustImage'}}"
                aria-pressed="{{shop.builder.imageEditing}}">
                <i class="fa-solid {{#if shop.builder.imageEditing}}fa-check{{else}}fa-crop-simple{{/if}}" aria-hidden="true"></i>
              </button>
              {{#if shop.builder.imageEditing}}
                <span class="symbaroum-hud-shop-merchant-image-hint">
                  <i class="fa-solid fa-hand" aria-hidden="true"></i>
                  {{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.DirectImageEditHint"}}
                </span>
              {{/if}}
            </div>
          {{else}}
            <div class="symbaroum-hud-shop-merchant-image symbaroum-hud-shop-merchant-image-static"
              style="{{shop.builder.imageStyle}}">
              <img src="{{shop.builder.img}}" alt="">
            </div>
          {{/if}}

          {{#if shop.cart.empty}}
            {{#if shop.builder.editable}}
              <label class="symbaroum-hud-shop-description-field">
                <strong>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.Description"}}</strong>
                <textarea data-shop-description maxlength="6000"
                  placeholder="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.DescriptionPlaceholder'}}">{{shop.builder.description}}</textarea>
              </label>
            {{else}}
              <div class="symbaroum-hud-shop-description-field symbaroum-hud-shop-description-static">
                <strong>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.Description"}}</strong>
                <p>{{shop.builder.description}}</p>
              </div>
            {{/if}}
          {{else}}
            <section class="symbaroum-hud-shop-merchant-cart"
              aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartTitle'}}">
              <header>
                <h2>
                  <i class="fa-solid fa-basket-shopping" aria-hidden="true"></i>
                  {{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.CartTitle"}}
                  <small>{{shop.cart.count}}</small>
                </h2>
                <button type="button" data-action="cart-clear"
                  data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartClear'}}"
                  aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartClear'}}">
                  <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                </button>
              </header>
              <div class="symbaroum-hud-shop-merchant-cart-items">
                {{#each shop.cart.items}}
                  <article data-cart-uuid="{{uuid}}">
                    <img src="{{img}}" alt="">
                    <span>
                      <strong>{{name}}</strong>
                      <small>{{#if service}}<i class="fa-solid fa-bell-concierge" aria-hidden="true"></i> {{localize "SYMBAROUMHUD.Services.Service"}} · {{/if}}{{unitPrice}}</small>
                    </span>
                    <div>
                      <button type="button" data-action="cart-decrease" data-uuid="{{uuid}}"
                        aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartDecrease'}} {{name}}">
                        <i class="fa-solid fa-minus" aria-hidden="true"></i>
                      </button>
                      <b>{{quantity}}</b>
                      <button type="button" data-action="cart-increase" data-uuid="{{uuid}}"
                        aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartIncrease'}} {{name}}">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                      </button>
                    </div>
                    <button type="button" data-action="cart-remove" data-uuid="{{uuid}}"
                      aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartRemove'}} {{name}}">
                      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                  </article>
                {{/each}}
              </div>
              <footer>
                <span>
                  <small>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.CartTotal"}}</small>
                  <strong>{{shop.cart.totalLabel}}</strong>
                </span>
                <button type="button" data-action="cart-checkout" {{#unless shop.cart.canCheckout}}disabled{{/unless}}>
                  <i class="fa-solid fa-coins" aria-hidden="true"></i>
                  {{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.CartCheckout"}}
                </button>
              </footer>
            </section>
          {{/if}}
        </aside>
        <div class="symbaroum-hud-shop-builder-workspace">
          <div class="symbaroum-hud-browser-filter-popover symbaroum-hud-shop-custom-filter"
            data-browser-filter-panel {{#unless filters.open}}hidden{{/unless}}>
            <section class="symbaroum-hud-browser-taxonomy-filter symbaroum-hud-browser-collapsible-filter"
              data-expanded="{{filters.sections.taxonomies}}">
              <header>
                <button type="button" class="symbaroum-hud-browser-filter-heading"
                  data-action="toggle-filter-section" data-filter-section="taxonomies"
                  aria-expanded="{{filters.sections.taxonomies}}">
                  <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                  <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.ItemCategories"}}</span>
                </button>
                <button type="button" data-action="toggle-all-taxonomies"
                  aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.ToggleItemCategories'}}">
                  <i class="fa-solid fa-check-double" aria-hidden="true"></i>
                </button>
              </header>
              <div {{#unless filters.sections.taxonomies}}hidden{{/unless}}>
                {{#each filterTaxonomies}}
                  <label data-empty="{{#unless count}}true{{else}}false{{/unless}}">
                    <input type="checkbox" data-browser-taxonomy value="{{id}}" {{#if checked}}checked{{/if}}>
                    <span>{{label}}</span><small>{{count}}</small>
                  </label>
                {{/each}}
              </div>
            </section>
            <section class="symbaroum-hud-browser-origin-filter symbaroum-hud-browser-collapsible-filter"
              data-expanded="{{filters.sections.origins}}">
              <header>
                <button type="button" class="symbaroum-hud-browser-filter-heading"
                  data-action="toggle-filter-section" data-filter-section="origins"
                  aria-expanded="{{filters.sections.origins}}">
                  <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                  <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.Origin"}}</span>
                </button>
                <button type="button" data-action="toggle-all-origins"
                  aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.ToggleOrigins'}}">
                  <i class="fa-solid fa-check-double" aria-hidden="true"></i>
                </button>
              </header>
              <div {{#unless filters.sections.origins}}hidden{{/unless}}>
                {{#each origins}}
                  <label data-empty="{{#unless count}}true{{else}}false{{/unless}}">
                    <input type="checkbox" data-browser-origin value="{{id}}" {{#if checked}}checked{{/if}}>
                    <span>{{label}}</span><small>{{count}}</small>
                  </label>
                {{/each}}
              </div>
            </section>
            <section class="symbaroum-hud-browser-source-filter symbaroum-hud-browser-collapsible-filter"
              data-expanded="{{filters.sections.sources}}">
              <header>
                <button type="button" class="symbaroum-hud-browser-filter-heading"
                  data-action="toggle-filter-section" data-filter-section="sources"
                  aria-expanded="{{filters.sections.sources}}">
                  <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                  <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.Sources"}}</span>
                </button>
                <button type="button" data-action="toggle-all-sources"
                  aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.ToggleSources'}}">
                  <i class="fa-solid fa-check-double" aria-hidden="true"></i>
                </button>
              </header>
              <div {{#unless filters.sections.sources}}hidden{{/unless}}>
                {{#each sources}}
                  <label data-empty="{{#unless count}}true{{else}}false{{/unless}}">
                    <input type="checkbox" data-browser-source value="{{id}}" {{#if checked}}checked{{/if}}>
                    <span>{{label}}</span><small>{{count}}</small>
                  </label>
                {{/each}}
              </div>
            </section>
          </div>

          <main class="symbaroum-hud-browser-results symbaroum-hud-shop-custom-results">
            <div class="symbaroum-hud-shop-results-search">
              <label class="symbaroum-hud-browser-search">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input type="search" data-browser-search value="{{query}}"
                  placeholder="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Search'}}"
                  aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Search'}}">
                {{#if query}}
                  <button type="button" data-action="clear-search"
                    aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.ClearSearch'}}">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                  </button>
                {{/if}}
                <button type="button" class="symbaroum-hud-browser-filter-toggle"
                  data-action="toggle-filters" data-active="{{filters.open}}"
                  aria-expanded="{{filters.open}}"
                  aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Filters'}}"
                  data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Filters'}}">
                  <i class="fa-solid fa-filter" aria-hidden="true"></i>
                </button>
              </label>
            </div>
            {{#if shop.builder.managingStock}}
              <nav class="symbaroum-hud-shop-stock-sections" aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.StockSections'}}">
                <button type="button" data-action="select-stock-section" data-stock-section="items"
                  data-active="{{shop.builder.stockSection.items}}" aria-pressed="{{shop.builder.stockSection.items}}">
                  <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                  <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockItemsTab"}}</span>
                </button>
                <button type="button" data-action="select-stock-section" data-stock-section="services"
                  data-active="{{shop.builder.stockSection.services}}" aria-pressed="{{shop.builder.stockSection.services}}">
                  <i class="fa-solid fa-bell-concierge" aria-hidden="true"></i>
                  <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockServicesTab"}}</span>
                </button>
              </nav>
            {{/if}}
            <header>
              <h2>{{#if shop.builder.managingStock}}{{#if shop.builder.stockSection.services}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockServicesTitle"}}{{else}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockItemsTitle"}}{{/if}}{{else}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.AvailableItems"}}{{/if}}</h2>
              <span>{{resultCount}} {{localize "SYMBAROUMHUD.CompendiumBrowser.Found"}}</span>
            </header>
            <ol>
              {{#each entries}}
                <li data-browser-uuid="{{uuid}}" data-document-class="{{documentClass}}">
                  <button type="button" class="symbaroum-hud-browser-entry-main"
                    data-action="open-document" data-uuid="{{uuid}}" aria-label="{{name}}">
                    <img src="{{img}}" alt="">
                    <span class="symbaroum-hud-browser-entry-details">
                      <strong>{{name}}</strong>
                      <small>{{#if service}}<i class="fa-solid fa-bell-concierge" aria-hidden="true"></i> {{/if}}{{subtitle}}{{#if reference}} · {{reference}}{{/if}}</small>
                    </span>
                    <span class="symbaroum-hud-browser-entry-source">
                      {{#unless ../shop.active}}
                        <span class="symbaroum-hud-browser-entry-source-label">{{sourceLabel}}</span>
                      {{/unless}}
                      <em class="symbaroum-hud-browser-entry-origin" data-origin="{{origin}}">
                        <i class="fa-solid fa-bookmark" aria-hidden="true"></i> {{originLabel}}
                      </em>
                    </span>
                  </button>
                  <span class="symbaroum-hud-browser-entry-controls">
                    {{#if ../shop.builder.managingStock}}
                      {{#if stockConfigured}}
                        {{#if service}}
                          <button type="button" class="symbaroum-hud-service-stock-mode"
                            data-action="toggle-stock-unlimited" data-uuid="{{uuid}}"
                            data-unlimited="{{stockUnlimited}}"
                            data-tooltip="{{localize 'SYMBAROUMHUD.Services.ToggleUnlimited'}}">
                            <i class="fa-solid {{#if stockUnlimited}}fa-infinity{{else}}fa-boxes-stacked{{/if}}" aria-hidden="true"></i>
                            {{#if stockUnlimited}}{{localize "SYMBAROUMHUD.Services.Unlimited"}}{{else}}{{localize "SYMBAROUMHUD.Services.Limited"}}{{/if}}
                          </button>
                        {{/if}}
                        {{#unless stockUnlimited}}
                          <span class="symbaroum-hud-shop-stock-quantity">
                            <button type="button" data-action="stock-decrease" data-uuid="{{uuid}}"
                              aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.StockDecrease'}} {{name}}">
                              <i class="fa-solid fa-minus" aria-hidden="true"></i>
                            </button>
                            <input type="number" data-shop-stock-quantity data-uuid="{{uuid}}"
                              value="{{stockQuantity}}" min="0" max="99999" step="1"
                              aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.StockQuantity'}} {{name}}">
                            <button type="button" data-action="stock-increase" data-uuid="{{uuid}}"
                              aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.StockIncrease'}} {{name}}">
                              <i class="fa-solid fa-plus" aria-hidden="true"></i>
                            </button>
                          </span>
                        {{/unless}}
                        <button type="button" class="symbaroum-hud-shop-stock-remove"
                          data-action="stock-remove" data-uuid="{{uuid}}"
                          data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.StockRemove'}}"
                          aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.StockRemove'}} {{name}}">
                          <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                        </button>
                      {{else}}
                        <button type="button" class="symbaroum-hud-shop-stock-add"
                          data-action="stock-add" data-uuid="{{uuid}}">
                          <i class="fa-solid fa-plus" aria-hidden="true"></i>
                          {{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockAdd"}}
                        </button>
                      {{/if}}
                    {{else}}
                      <span class="symbaroum-hud-shop-stock-available" data-empty="{{#unless stockRemaining}}true{{else}}false{{/unless}}">
                        {{#if stockRemaining}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockQuantity"}}: {{stockRemainingLabel}}{{else}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.OutOfStock"}}{{/if}}
                      </span>
                      <button type="button" class="symbaroum-hud-shop-buy" data-action="buy-document"
                        data-uuid="{{uuid}}" data-affordable="{{canBuy}}" {{#unless canBuy}}disabled{{/unless}}
                        aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.AddToCart'}} {{name}} — {{priceLabel}}">
                        <span>{{priceLabel}}</span><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                        {{#if inCartQuantity}}<em>{{inCartQuantity}}</em>{{/if}}
                      </button>
                    {{/if}}
                  </span>
                </li>
              {{else}}
                <li class="symbaroum-hud-browser-empty">
                  {{#if shop.builder.managingStock}}
                    <i class="fa-solid {{#if shop.builder.stockSection.services}}fa-bell-concierge{{else}}fa-box-open{{/if}}" aria-hidden="true"></i>
                    <strong>{{#if shop.builder.stockSection.services}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockServiceSearchEmpty"}}{{else}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockSearchEmpty"}}{{/if}}</strong>
                    <span>{{#if shop.builder.stockSection.services}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockServiceSearchEmptyHint"}}{{else}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockSearchEmptyHint"}}{{/if}}</span>
                  {{else}}
                    <i class="fa-solid fa-store-slash" aria-hidden="true"></i>
                    <strong>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockEmpty"}}</strong>
                    <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.StockEmptyHint"}}</span>
                  {{/if}}
                </li>
              {{/each}}
              {{#if hasMore}}
                <li class="symbaroum-hud-browser-load-more">
                  <button type="button" data-action="load-more">
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.LoadMore"}}</span>
                    <small>{{renderedCount}} / {{resultCount}}</small>
                  </button>
                </li>
              {{/if}}
            </ol>
          </main>

          <footer class="symbaroum-hud-shop-custom-wallet">
            <div class="symbaroum-hud-shop-custom-money">
              <strong><i class="fa-solid fa-coins" aria-hidden="true"></i> {{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.Balance"}}</strong>
              <span><b>{{shop.balance.thaler}}</b><small>{{localize "MONEY.THALER"}}</small></span>
              <span><b>{{shop.balance.shilling}}</b><small>{{localize "MONEY.SHILLING"}}</small></span>
              <span><b>{{shop.balance.orteg}}</b><small>{{localize "MONEY.ORTEG"}}</small></span>
            </div>
          </footer>
        </div>
      </div>
    </section>
  {{/if}}

  <nav class="symbaroum-hud-browser-tabs" aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.CategoriesLabel'}}">
    {{#each categories}}
      {{#if visible}}
        <button type="button" data-action="category" data-category="{{id}}"
          data-active="{{active}}" data-depth="{{depth}}" data-has-children="{{hasChildren}}"
          aria-pressed="{{active}}" data-tooltip="{{label}} ({{count}})" aria-label="{{label}}">
          <i class="fa-solid {{icon}}" aria-hidden="true"></i>
          {{#if ../shop.active}}<small>{{count}}</small>{{/if}}
        </button>
      {{/if}}
    {{/each}}
  </nav>

  <aside class="symbaroum-hud-browser-sidebar">
    <div class="symbaroum-hud-browser-filter-toolbar">
      <label class="symbaroum-hud-browser-search">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" data-browser-search value="{{query}}"
          placeholder="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Search'}}"
          aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Search'}}">
        {{#if query}}
          <button type="button" data-action="clear-search"
            aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.ClearSearch'}}">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        {{/if}}
      </label>
      <button type="button" class="symbaroum-hud-browser-filter-toggle"
        data-action="toggle-filters" data-active="{{filters.open}}"
        aria-expanded="{{filters.open}}"
        aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Filters'}}"
        data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Filters'}}">
        <i class="fa-solid fa-filter" aria-hidden="true"></i>
      </button>
    </div>

    {{#if shop.active}}
      <section class="symbaroum-hud-shop-balance" aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.Balance'}}">
        <header>
          <h2><i class="fa-solid fa-coins" aria-hidden="true"></i> {{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.Balance"}}</h2>
        </header>
        <div>
          <span><strong>{{shop.balance.thaler}}</strong><small>{{localize "MONEY.THALER"}}</small></span>
          <span><strong>{{shop.balance.shilling}}</strong><small>{{localize "MONEY.SHILLING"}}</small></span>
          <span><strong>{{shop.balance.orteg}}</strong><small>{{localize "MONEY.ORTEG"}}</small></span>
        </div>
      </section>

      <section class="symbaroum-hud-shop-cart" aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartTitle'}}">
        <header>
          <h2>
            <i class="fa-solid fa-basket-shopping" aria-hidden="true"></i>
            {{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.CartTitle"}}
            {{#unless shop.cart.empty}}<small>{{shop.cart.count}}</small>{{/unless}}
          </h2>
          {{#unless shop.cart.empty}}
            <button type="button" data-action="cart-clear"
              data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartClear'}}"
              aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartClear'}}">
              <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
            </button>
          {{/unless}}
        </header>

        {{#if shop.cart.empty}}
          <div class="symbaroum-hud-shop-cart-empty">
            <i class="fa-solid fa-basket-shopping" aria-hidden="true"></i>
            <strong>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.CartEmpty"}}</strong>
            <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.CartEmptyHint"}}</span>
          </div>
        {{else}}
          <div class="symbaroum-hud-shop-cart-items">
            {{#each shop.cart.items}}
              <article class="symbaroum-hud-shop-cart-item" data-cart-uuid="{{uuid}}">
                <img src="{{img}}" alt="">
                <span class="symbaroum-hud-shop-cart-item-name">
                  <strong>{{name}}</strong>
                  <small>{{#if service}}<i class="fa-solid fa-bell-concierge" aria-hidden="true"></i> {{localize "SYMBAROUMHUD.Services.Service"}} · {{/if}}{{unitPrice}}</small>
                </span>
                <span class="symbaroum-hud-shop-cart-quantity">
                  <button type="button" data-action="cart-decrease" data-uuid="{{uuid}}"
                    data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartDecrease'}}"
                    aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartDecrease'}} {{name}}">
                    <i class="fa-solid fa-minus" aria-hidden="true"></i>
                  </button>
                  <strong>{{quantity}}</strong>
                  <button type="button" data-action="cart-increase" data-uuid="{{uuid}}"
                    data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartIncrease'}}"
                    aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartIncrease'}} {{name}}">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                  </button>
                </span>
                <small class="symbaroum-hud-shop-cart-subtotal">{{subtotal}}</small>
                <button type="button" class="symbaroum-hud-shop-cart-remove" data-action="cart-remove" data-uuid="{{uuid}}"
                  data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartRemove'}}"
                  aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.CartRemove'}} {{name}}">
                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
              </article>
            {{/each}}
          </div>
          <footer>
            <div>
              <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.CartTotal"}}</span>
              <strong>{{shop.cart.totalLabel}}</strong>
              <small>{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.CartRemaining"}}: {{shop.cart.remaining.thaler}} {{localize "MONEY.THALER"}}, {{shop.cart.remaining.shilling}} {{localize "MONEY.SHILLING"}}, {{shop.cart.remaining.orteg}} {{localize "MONEY.ORTEG"}}</small>
            </div>
            <button type="button" data-action="cart-checkout" {{#unless shop.cart.canCheckout}}disabled{{/unless}}>
              <i class="fa-solid fa-coins" aria-hidden="true"></i>
              {{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.CartCheckout"}}
            </button>
          </footer>
        {{/if}}
      </section>
    {{/if}}

    <div class="symbaroum-hud-browser-filter-popover" data-browser-filter-panel {{#unless filters.open}}hidden{{/unless}}>
      <section class="symbaroum-hud-browser-taxonomy-filter symbaroum-hud-browser-collapsible-filter"
        data-expanded="{{filters.sections.taxonomies}}">
        <header>
          <button type="button" class="symbaroum-hud-browser-filter-heading"
            data-action="toggle-filter-section" data-filter-section="taxonomies"
            aria-expanded="{{filters.sections.taxonomies}}">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.ItemCategories"}}</span>
          </button>
          <button type="button" data-action="toggle-all-taxonomies"
            data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.ToggleItemCategories'}}"
            aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.ToggleItemCategories'}}">
            <i class="fa-solid fa-check-double" aria-hidden="true"></i>
          </button>
        </header>
        <div {{#unless filters.sections.taxonomies}}hidden{{/unless}}>
          {{#each filterTaxonomies}}
            <label data-empty="{{#unless count}}true{{else}}false{{/unless}}">
              <input type="checkbox" data-browser-taxonomy value="{{id}}" {{#if checked}}checked{{/if}}>
              <span>{{label}}</span>
              <small>{{count}}</small>
            </label>
          {{/each}}
        </div>
      </section>

      <section class="symbaroum-hud-browser-origin-filter symbaroum-hud-browser-collapsible-filter"
        data-expanded="{{filters.sections.origins}}">
        <header>
          <button type="button" class="symbaroum-hud-browser-filter-heading"
            data-action="toggle-filter-section" data-filter-section="origins"
            aria-expanded="{{filters.sections.origins}}">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.Origin"}}</span>
          </button>
          <button type="button" data-action="toggle-all-origins"
            data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.ToggleOrigins'}}"
            aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.ToggleOrigins'}}">
            <i class="fa-solid fa-check-double" aria-hidden="true"></i>
          </button>
        </header>
        <div {{#unless filters.sections.origins}}hidden{{/unless}}>
          {{#each origins}}
            <label data-empty="{{#unless count}}true{{else}}false{{/unless}}">
              <input type="checkbox" data-browser-origin value="{{id}}" {{#if checked}}checked{{/if}}>
              <span>{{label}}</span>
              <small>{{count}}</small>
            </label>
          {{/each}}
        </div>
      </section>

      <section class="symbaroum-hud-browser-source-filter symbaroum-hud-browser-collapsible-filter"
        data-expanded="{{filters.sections.sources}}">
        <header>
          <button type="button" class="symbaroum-hud-browser-filter-heading"
            data-action="toggle-filter-section" data-filter-section="sources"
            aria-expanded="{{filters.sections.sources}}">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.Sources"}}</span>
          </button>
          <button type="button" data-action="toggle-all-sources"
            data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.ToggleSources'}}"
            aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.ToggleSources'}}">
            <i class="fa-solid fa-check-double" aria-hidden="true"></i>
          </button>
        </header>
        <div {{#unless filters.sections.sources}}hidden{{/unless}}>
          {{#each sources}}
            <label data-empty="{{#unless count}}true{{else}}false{{/unless}}">
              <input type="checkbox" data-browser-source value="{{id}}" {{#if checked}}checked{{/if}}>
              <span>{{label}}</span>
              <small>{{count}}</small>
            </label>
          {{/each}}
        </div>
      </section>
    </div>
  </aside>

  <main class="symbaroum-hud-browser-results">
    <header>
      <h2>{{#if shop.active}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.AvailableItems"}}{{else}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Results"}}{{/if}}</h2>
      <span>{{resultCount}} {{localize "SYMBAROUMHUD.CompendiumBrowser.Found"}}</span>
    </header>
    <ol>
      {{#each entries}}
        <li data-browser-uuid="{{uuid}}" data-document-class="{{documentClass}}" {{#unless ../shop.active}}draggable="true"{{/unless}}>
          <button type="button" class="symbaroum-hud-browser-entry-main"
            data-action="open-document" data-uuid="{{uuid}}"
            aria-label="{{name}}">
            <img src="{{img}}" alt="">
            <span class="symbaroum-hud-browser-entry-details">
              <strong>{{name}}</strong>
              <small>{{#if service}}<i class="fa-solid fa-bell-concierge" aria-hidden="true"></i> {{/if}}{{subtitle}}{{#if reference}} · {{reference}}{{/if}}</small>
            </span>
            <span class="symbaroum-hud-browser-entry-source">
              <span class="symbaroum-hud-browser-entry-source-label">{{sourceLabel}}</span>
              <em class="symbaroum-hud-browser-entry-origin" data-origin="{{origin}}">
                <i class="fa-solid fa-bookmark" aria-hidden="true"></i>
                {{originLabel}}
              </em>
            </span>
          </button>
          <span class="symbaroum-hud-browser-entry-controls">
            {{#if ../shop.active}}
              <button type="button" class="symbaroum-hud-shop-buy" data-action="buy-document"
                data-uuid="{{uuid}}" data-affordable="{{canBuy}}" {{#unless canBuy}}disabled{{/unless}}
                data-tooltip="{{#if canBuy}}{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.AddToCart'}}{{else}}{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.Insufficient'}}{{/if}}: {{name}}"
                aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Shop.AddToCart'}} {{name}} — {{priceLabel}}">
                <span>{{priceLabel}}</span>
                <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                {{#if inCartQuantity}}<em>{{inCartQuantity}}</em>{{/if}}
              </button>
            {{/if}}
            {{#if ../selection.active}}
              <label data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.Select'}}: {{name}}">
                <input type="checkbox" data-browser-select value="{{uuid}}" {{#if selected}}checked{{/if}}>
                <i class="fa-solid fa-check" aria-hidden="true"></i>
              </label>
            {{/if}}
            {{#if canAdd}}
              <button type="button" data-action="add-document" data-uuid="{{uuid}}"
                data-tooltip="{{localize 'SYMBAROUMHUD.CompendiumBrowser.AddTo'}} {{../actor.name}}"
                aria-label="{{localize 'SYMBAROUMHUD.CompendiumBrowser.AddTo'}} {{../actor.name}}">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
              </button>
            {{/if}}
          </span>
        </li>
      {{else}}
        <li class="symbaroum-hud-browser-empty">
          <i class="fa-solid {{#if shop.active}}fa-store-slash{{else}}fa-book-open{{/if}}" aria-hidden="true"></i>
          <strong>{{#if shop.active}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.Empty"}}{{else}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Empty"}}{{/if}}</strong>
          <span>{{#if shop.active}}{{localize "SYMBAROUMHUD.CompendiumBrowser.Shop.EmptyHint"}}{{else}}{{localize "SYMBAROUMHUD.CompendiumBrowser.EmptyHint"}}{{/if}}</span>
        </li>
      {{/each}}
      {{#if hasMore}}
        <li class="symbaroum-hud-browser-load-more">
          <button type="button" data-action="load-more">
            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            <span>{{localize "SYMBAROUMHUD.CompendiumBrowser.LoadMore"}}</span>
            <small>{{renderedCount}} / {{resultCount}}</small>
          </button>
        </li>
      {{/if}}
    </ol>
  </main>

  {{#if selection.active}}
    <footer class="symbaroum-hud-browser-footer" data-valid="{{selection.valid}}">
      <span>{{selection.summary}}</span>
      <button type="button" data-action="confirm-selection" {{#unless selection.valid}}disabled{{/unless}}>
        <i class="fa-solid fa-check" aria-hidden="true"></i>
        {{localize "SYMBAROUMHUD.CompendiumBrowser.ConfirmSelection"}}
      </button>
    </footer>
  {{/if}}
</div>
